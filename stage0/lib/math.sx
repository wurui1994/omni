;; Omni 运行库：实数上的超越函数（核心方言写的，语言中立）
;;
;; 为什么这一族不转手宿主的 libm / Math：量过（ADR-0014 里那一节）——
;;   - 同一批 20 万个输入上算 sin/cos/tan/atan/exp/log，libm(macOS) 与 V8 的 120 万个结果里
;;     51.1 万个位不同，按 `%.15g` 印出来还有 31.7 万个字符串不同；
;;   - 用 bc -l（scale=45）当高精度参考，400 个输入里 macOS libm 的 sin 有 28 个差 1 ULP，
;;     V8 有 22 个，且不是同一批 —— **判分的那一方自己就不是正确舍入的**。
;; 所以这里自己算：只用 + - * / 与 floor（都是精确定义的运算），六条腿算出的位一模一样。
;; 代价写在明处：与真 asy 相比允许 1 ULP 的差，用它的用例走带容差的那一节测试。
;;
;; 这个文件是**运行库**，不是某个前端的一部分 —— asy 的 `exp`、jancy 的 `exp`、
;; Omni 自己的 `exp` 都绑到这里的同一个符号上。绑定关系是各语言的一张数据表
;; （asy 那张在 frontend-asy/builtins.tab），不是写在降级器里的代码。
;;
;; 命名：`omni_` 前缀 + 小写。模块级名字全局唯一（ADR-0011/0014 的封闭 ABI）。

  (fn omni_pow2 ((n int)) real
    ;; 2^n（n 是整数）。写成**循环**而不是 pow：乘 2 与乘 0.5 在正规数范围里是精确的，
    ;; pow 不是（各家实现不同）。只保证 n >= -1000：更小的由调用方拆成两步（见 omni_exp），
    ;; 不然连续减半会一路掉进次正规、每一步都再舍入一次。
    (let m real (real 1.0))
    (let i int (int 0))
    (if (bin ">" (var n) (int 0))
      (do (while (bin "<" (var i) (var n))
        (do (set m (bin "*" (var m) (real 2.0))) (set i (bin "+" (var i) (int 1))))))
      (do (while (bin "<" (var i) (un "-" (var n)))
        (do (set m (bin "*" (var m) (real 0.5))) (set i (bin "+" (var i) (int 1)))))))
    (ret (var m)))

  (fn omni_exp ((x real)) real
    ;; e^x。k = floor(x/ln2 + 0.5)，r = x - k*ln2（ln2 拆 hi/lo 两段，Cody-Waite），
    ;; e^x = 2^k * e^r，e^r 用到 1/13! 的泰勒 Horner（|r| <= ln2/2 上截断误差 ~2^-70）。
    ;; 量过：与 V8 的 Math.exp 在 20 万个随机输入上最大差 1 ULP（没有更差的）。
    (if (bin "!=" (var x) (var x)) (do (ret (var x))))
    (if (bin ">" (var x) (real 709.78271289338400)) (do (ret (bin "*" (real 1e308) (real 10.0)))))
    (if (bin "<" (var x) (real -745.13321910194110)) (do (ret (real 0.0))))
    (let k real (rmath "floor" (bin "+" (bin "*" (var x) (real 1.4426950408889634)) (real 0.5))))
    (let r real (bin "-" (bin "-" (var x) (bin "*" (var k) (real 0.69314718036912382)))
      (bin "*" (var k) (real 1.9082149292705877e-10))))
    (let s real (real 1.6059043836821613e-10))
    (set s (bin "+" (real 2.0876756987868100e-9) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 2.5052108385441720e-8) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 2.7557319223985888e-7) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 0.0000027557319223985893) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 0.000024801587301587302) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 0.00019841269841269841) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 0.0013888888888888889) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 0.0083333333333333332) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 0.041666666666666664) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 0.16666666666666666) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 0.50000000000000000) (bin "*" (var r) (var s))))
    (set s (bin "+" (real 1.0000000000000000) (bin "*" (var r) (var s))))
    (let e real (bin "+" (real 1.0) (bin "*" (var r) (var s))))
    (let n int (toint (var k)))
    (if (bin "<" (var n) (int -1000))
      (do (ret (bin "*" (bin "*" (var e) (call omni_pow2 (bin "+" (var n) (int 1000))))
        (call omni_pow2 (int -1000))))))
    (ret (bin "*" (var e) (call omni_pow2 (var n)))))

  (fn omni__sinp ((r real)) real
    ;; sin(r) 在 |r| <= pi/4 上的泰勒（到 r^17，截断误差 ~2^-65）。系数是 1/(2k+1)! 带符号，
    ;; 由 /tmp 的生成器印出来的 17 位十进制，不手抄。
    (let z real (bin "*" (var r) (var r)))
    (let s real (real 2.8114572543455206e-15))
    (set s (bin "+" (real -7.6471637318198164e-13) (bin "*" (var z) (var s))))
    (set s (bin "+" (real 1.6059043836821613e-10) (bin "*" (var z) (var s))))
    (set s (bin "+" (real -2.5052108385441720e-8) (bin "*" (var z) (var s))))
    (set s (bin "+" (real 0.0000027557319223985893) (bin "*" (var z) (var s))))
    (set s (bin "+" (real -0.00019841269841269841) (bin "*" (var z) (var s))))
    (set s (bin "+" (real 0.0083333333333333332) (bin "*" (var z) (var s))))
    (set s (bin "+" (real -0.16666666666666666) (bin "*" (var z) (var s))))
    (set s (bin "+" (real 1.0000000000000000) (bin "*" (var z) (var s))))
    (ret (bin "*" (var r) (var s))))

  (fn omni__cosp ((r real)) real
    ;; cos(r) 在 |r| <= pi/4 上的泰勒（到 r^16）
    (let z real (bin "*" (var r) (var r)))
    (let s real (real 4.7794773323873853e-14))
    (set s (bin "+" (real -1.1470745597729725e-11) (bin "*" (var z) (var s))))
    (set s (bin "+" (real 2.0876756987868100e-9) (bin "*" (var z) (var s))))
    (set s (bin "+" (real -2.7557319223985888e-7) (bin "*" (var z) (var s))))
    (set s (bin "+" (real 0.000024801587301587302) (bin "*" (var z) (var s))))
    (set s (bin "+" (real -0.0013888888888888889) (bin "*" (var z) (var s))))
    (set s (bin "+" (real 0.041666666666666664) (bin "*" (var z) (var s))))
    (set s (bin "+" (real -0.50000000000000000) (bin "*" (var z) (var s))))
    (ret (bin "+" (real 1.0) (bin "*" (var z) (var s)))))

  (fn omni__pio2q ((x real)) int
    ;; 归约的**象限**：n mod 4（n 是 x 离哪个 pi/2 的整数倍最近）
    (let n real (rmath "floor" (bin "+" (bin "*" (var x) (real 0.63661977236758138)) (real 0.5))))
    (ret (toint (bin "-" (var n) (bin "*" (rmath "floor" (bin "/" (var n) (real 4.0))) (real 4.0))))))

  (fn omni__pio2r ((x real)) real
    ;; 归约的**余项** r = x - n*(pi/2)，用 **double-double**（Dekker）算 n*(pi/2)。
    ;; 为什么非要 dd：量过朴素的三段 Cody-Waite 在 |x|<1000 上就有 189 ULP 的误差、
    ;; |x|<1e6 彻底散架（因为 n*pio2 那几个乘积本身不精确，而 x - n*pio2 又要抵消几十位）。
    ;; 改成 dd 之后 |x| 到 1e9 都是最多 2 ULP（对比 V8，5 组 5 万个随机输入）。
    ;; 只用 + - *（**不用 FMA** —— C 那条腿因此要 -ffp-contract=off，见 cli.js 的 ccFlags）。
    ;; pi/2 拆成 P0+P1+P2 三段：1.5707963267948966 + 6.123233995736766e-17 + -1.4973849048591698e-33
    (let n real (rmath "floor" (bin "+" (bin "*" (var x) (real 0.63661977236758138)) (real 0.5))))
    ;; twoProd(n, P0)：Dekker 分裂（2^27+1），得到精确的 p + pe
    (let p real (bin "*" (var n) (real 1.5707963267948966)))
    (let t real (bin "*" (var n) (real 134217729.0)))
    (let nh real (bin "-" (var t) (bin "-" (var t) (var n))))
    (let nl real (bin "-" (var n) (var nh)))
    (let u real (bin "*" (real 1.5707963267948966) (real 134217729.0)))
    (let bh real (bin "-" (var u) (bin "-" (var u) (real 1.5707963267948966))))
    (let bl real (bin "-" (real 1.5707963267948966) (var bh)))
    (let pe real (bin "+" (bin "+" (bin "+"
      (bin "-" (bin "*" (var nh) (var bh)) (var p))
      (bin "*" (var nh) (var bl))) (bin "*" (var nl) (var bh))) (bin "*" (var nl) (var bl))))
    ;; twoSum(x, -p)
    (let s real (bin "-" (var x) (var p)))
    (let bb real (bin "-" (var s) (var x)))
    (let se real (bin "+" (bin "-" (var x) (bin "-" (var s) (var bb)))
      (bin "-" (un "-" (var p)) (var bb))))
    (let hi real (var s))
    (let lo real (bin "-" (var se) (var pe)))
    ;; twoProd(n, P1)
    (let q real (bin "*" (var n) (real 6.1232339957367660e-17)))
    (let u2 real (bin "*" (real 6.1232339957367660e-17) (real 134217729.0)))
    (let ch real (bin "-" (var u2) (bin "-" (var u2) (real 6.1232339957367660e-17))))
    (let cl real (bin "-" (real 6.1232339957367660e-17) (var ch)))
    (let qe real (bin "+" (bin "+" (bin "+"
      (bin "-" (bin "*" (var nh) (var ch)) (var q))
      (bin "*" (var nh) (var cl))) (bin "*" (var nl) (var ch))) (bin "*" (var nl) (var cl))))
    ;; twoSum(hi, -q)
    (let s2 real (bin "-" (var hi) (var q)))
    (let b2 real (bin "-" (var s2) (var hi)))
    (let e2 real (bin "+" (bin "-" (var hi) (bin "-" (var s2) (var b2)))
      (bin "-" (un "-" (var q)) (var b2))))
    (set hi (var s2))
    (set lo (bin "-" (bin "-" (bin "+" (var lo) (var e2)) (var qe))
      (bin "*" (var n) (real -1.4973849048591698e-33))))
    (ret (bin "+" (var hi) (var lo))))

  (fn omni_sin ((x real)) real
    ;; sin(x)。归约到 |r| <= pi/4 之后按象限在 ±sin(r) / ±cos(r) 里挑。
    ;; 量过：|x| 到 1e9 与 V8 的 Math.sin 最多差 2 ULP（大多数逐位相同）——
    ;; 在 `%.15g` 的一位十进制容差之内，所以用例走 tests/asy/tol/ 那一节。
    (if (bin "!=" (var x) (var x)) (do (ret (var x))))
    (let q int (call omni__pio2q (var x)))
    (let r real (call omni__pio2r (var x)))
    (if (bin "==" (var q) (int 0)) (do (ret (call omni__sinp (var r)))))
    (if (bin "==" (var q) (int 1)) (do (ret (call omni__cosp (var r)))))
    (if (bin "==" (var q) (int 2)) (do (ret (un "-" (call omni__sinp (var r))))))
    (ret (un "-" (call omni__cosp (var r)))))

  (fn omni_cos ((x real)) real
    ;; cos(x)。象限比 sin 转过 1
    (if (bin "!=" (var x) (var x)) (do (ret (var x))))
    (let q int (call omni__pio2q (var x)))
    (let r real (call omni__pio2r (var x)))
    (if (bin "==" (var q) (int 0)) (do (ret (call omni__cosp (var r)))))
    (if (bin "==" (var q) (int 1)) (do (ret (un "-" (call omni__sinp (var r))))))
    (if (bin "==" (var q) (int 2)) (do (ret (un "-" (call omni__cosp (var r))))))
    (ret (call omni__sinp (var r))))
