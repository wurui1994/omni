; libm.def — x86_64-linux libm 的符号预设（交叉编译用）。
;
; glibc 2.34 起数学函数并进了 libc，但有些发行版的符号表里那一份仍只从 libm.so.6
; 露出来。这一份单列，链的时候 -lm 落到这儿。

LIBRARY libm.so.6
EXPORTS
acos
acosh
asin
asinh
atan
atan2
atanh
cbrt
ceil
cos
cosh
exp
expm1
fabs
floor
fma
fmax
fmin
fmod
hypot
ldexp
log
log10
log1p
log2
nextafter
pow
round
sin
sinh
sqrt
sqrtf
tan
tanh
trunc
