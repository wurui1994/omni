// Omni 标准库 —— 数值（控制台那套科学计算的第五层，设计文档阶段 5）
//
// 挑的这两格是**答案有闭式**的那两个（判据不必靠眼睛）：
//   * 积分 `numInteg` —— Simpson 对三次以下的多项式**是精确的**，所以
//     `∫₀¹ x² dx = 1/3`、`∫₀² x³ dx = 4` 可以直接比；
//   * 线性拟合 `numLinfit` —— 喂它一条真正的多项式上的点，系数必须原样出来。
//
// 照 gsl-shell 的一个真实事实（设计文档 §3）：它那边 `num.integ` **不是** GSL 的
// `gsl_odeiv/qag` 的绑定，而是**纯 Lua 重写**的 qag（`templates/qag.lua.in` 开头写着
// "Adapted from the GSL Library, version 1.14"）。所以这一层自己写一份不是偷懒，
// 是照它的做法 —— 而 `linfit` 那边它包的是 `gsl_multifit_linear`，我们用自己的矩阵消元。
//
// 名字都带 `num` 前缀（`json.omni` 头上那段账：名字太通用会泄进每个 import 者的作用域）。

import "std/matrix.omni";
import "std/complex.omni";

/**
 * 定积分（复合 Simpson + 加倍到收敛）。
 *
 * 为什么是"加倍到收敛"而不是固定份数：固定份数的话精度是个谜；加倍到
 * **两次估计之差 / 15 小于容差**（Simpson 的误差阶是 h⁴，这个 15 是 2⁴-1）就有话可说。
 * 上限 2^15 份 —— 到不了容差就交最后那一次的值，不假装收敛了（也不挂）。
 */
real numInteg(fn(real) -> real f, real a, real b, real tol) {
  if (b == a) { return 0.0; }
  int n = 2;
  real prev = numSimpson(f, a, b, n);
  int k = 0;
  while (k < 14) {
    n = n * 2;
    real cur = numSimpson(f, a, b, n);
    real err = cur - prev;
    if (err < 0.0) { err = -err; }
    if (err / 15.0 < tol) { return cur; }
    prev = cur;
    k = k + 1;
  }
  return prev;
}

/** 复合 Simpson，`n` 份（要偶数）。**对三次以下的多项式是精确的**。 */
real numSimpson(fn(real) -> real f, real a, real b, int n) {
  if (n < 2) { fail("num: Simpson 至少两份"); }
  if (n % 2 != 0) { n = n + 1; }
  real h = (b - a) / real(n);
  real acc = f(a) + f(b);
  int i = 1;
  while (i < n) {
    real x = a + real(i) * h;
    if (i % 2 == 1) { acc = acc + 4.0 * f(x); } else { acc = acc + 2.0 * f(x); }
    i = i + 1;
  }
  return acc * h / 3.0;
}

/**
 * 多项式最小二乘拟合，回系数（从常数项起）。
 *
 * 走**正规方程** `(XᵀX) c = Xᵀy`，解那一步用 `std/matrix.omni` 的消元（带选主元）。
 * 正规方程在高次上条件数差 —— 这一格照实说：`deg` 上到 3、4 就该换 QR 了，
 * QR 那一步现在**做得了**（`sqrt` 是内建了），只是还没做 —— 这一格的账记在这儿。
 * gsl-shell 那边这一层是
 * `gsl_multifit_linear`（走 SVD），所以它没有这个限制。
 */
Matrix numLinfit(list<real> xs, list<real> ys, int deg) {
  if (xs.length != ys.length) { fail("num: linfit 的两串长度不同"); }
  if (deg < 1) { fail("num: linfit 的次数至少 1"); }
  int m = xs.length;
  int p = deg + 1;
  if (m < p) { fail("num: linfit 的点数少于系数个数"); }
  // X 是 m x p 的范德蒙德矩阵
  Matrix x = matZeros(m, p);
  int i = 0;
  while (i < m) {
    real v = 1.0;
    int j = 0;
    while (j < p) {
      x.put(i, j, v);
      v = v * xs[i];
      j = j + 1;
    }
    i = i + 1;
  }
  Matrix y = matVec(ys);
  Matrix xt = x.t();
  return xt.mul(x).solve(xt.mul(y));
}

/** 把拟合出来的系数代回去算一个点（`c[0] + c[1] x + …`）。 */
real numPolyAt(Matrix c, real x) {
  real acc = 0.0;
  real v = 1.0;
  int i = 0;
  while (i < c.rows) {
    acc = acc + c.get(i, 0) * v;
    v = v * x;
    i = i + 1;
  }
  return acc;
}

/**
 * 求根：`f(x) = 0` 在 `[a, b]` 上的那一个（**二分 + 试位法**，要求两端异号）。
 *
 * gsl-shell 那边这一层是 `roots.lua` 的纯 Lua Brent（不是 GSL 绑定）。这儿收的是它的
 * 骨架而不是全套 Brent：**二分保底、试位法（regula falsi）加速**，每一步都夹在
 * 已知异号的区间里 —— 所以它不会像纯试位法那样在一侧卡死，也不必有 Brent 那套
 * 三点插值与五个分支。要 Brent 的全套再补，这一格的账在这儿写着。
 *
 * 两端不异号就**当场报**（不猜、不返回一个假的根）。
 */
real numRoot(fn(real) -> real f, real a, real b, real tol) {
  real fa = f(a);
  real fb = f(b);
  if (fa == 0.0) { return a; }
  if (fb == 0.0) { return b; }
  if ((fa < 0.0) == (fb < 0.0)) {
    fail("num: numRoot 要两端异号（f(a) 与 f(b) 一个正一个负）");
  }
  real lo = a;
  real hi = b;
  real flo = fa;
  real fhi = fb;
  int k = 0;
  while (k < 200) {
    // 试位法猜一个；落到区间外或太靠边就退回中点
    real m = lo + (hi - lo) * 0.5;
    real den = fhi - flo;
    if (den != 0.0) {
      real t = lo - flo * (hi - lo) / den;
      real pad = (hi - lo) * 0.01;
      if (t > lo + pad && t < hi - pad) { m = t; }
    }
    real fm = f(m);
    if (fm == 0.0 || (hi - lo) < tol) { return m; }
    if ((fm < 0.0) == (flo < 0.0)) { lo = m; flo = fm; } else { hi = m; fhi = fm; }
    k = k + 1;
  }
  return lo + (hi - lo) * 0.5;
}

// ── 傅里叶变换（`fft-init.lua`，设计文档阶段 6）────────────────────────────────
//
// **照抄它的对外形状，不照抄它的存储**：gsl-shell 那边 `num.fft(v)` 回的是一个
// half-complex（`fft_hc`），实部虚部挤在同一块 `double[n]` 里，靠 `ft[k]` 那个索引
// 访问器（`halfcomplex_radix2_index`，`fft-init.lua:182-195`）把它翻成复数 ——
// 也就是说**用它的人看见的是"k 从 0 到 n-1，每格一个复数"**。我们直接回那个：
// 一串 `Complex`。省下来的那半份内存，在这一层不值得拿可读性换。
//
// 两条腿也照它分：**n 是 2 的幂走 radix-2**（它走 `gsl_fft_real_radix2_transform`），
// 不是就走一遍朴素 DFT（它走混合基的 `gsl_fft_real_transform`）—— 朴素那条是 O(n²)，
// 慢但答案对；混合基要不要补，看有没有人拿非 2 的幂喂它。**不报错、不假装**。

/** 正变换：实数序列 -> n 个复系数（`num.fft`）。 */
list<Complex> numFft(list<real> xs) {
  if (xs.length == 0) { fail("num: numFft 要至少一格"); }
  list<Complex> z = [];
  for (real v in xs) { z.push(cxOf(v, 0.0)); }
  return numFftC(z, -1.0);
}

/**
 * 逆变换：n 个复系数 -> 实数序列（`num.fftinv`）。
 *
 * 符号反过来、末尾除以 n（这一格分母的位置是约定 —— 我们与 GSL 一样把它放在逆变换上，
 * 于是 `numFftInv(numFft(x))` 就是 `x` 本身）。虚部**扔掉**：喂进去的是实序列的谱时
 * 它在舍入误差那一档，留着只会让答案看起来脏。
 */
list<real> numFftInv(list<Complex> ft) {
  if (ft.length == 0) { fail("num: numFftInv 要至少一格"); }
  list<Complex> z = numFftC(ft, 1.0);
  real s = 1.0 / real(ft.length);
  list<real> out = [];
  for (Complex c in z) { out.push(c.re * s); }
  return out;
}

/** 两条腿共用的那一趟（`sign` 是指数上的符号：正变换 -1、逆变换 +1）。 */
private list<Complex> numFftC(list<Complex> z, real sign) {
  int n = z.length;
  real tau = 8.0 * atan(1.0);          // 2π（这门语言没有 π 那个常数）
  list<Complex> a = [];
  for (Complex c in z) { a.push(cxOf(c.re, c.im)); }
  if (n < 2) { return a; }
  if (!numIsPow2(n)) {
    list<Complex> out = [];
    int k = 0;
    while (k < n) {
      real sre = 0.0;
      real sim = 0.0;
      int t = 0;
      while (t < n) {
        real ang = sign * tau * real(k) * real(t) / real(n);
        real c = cos(ang);
        real s = sin(ang);
        sre = sre + a[t].re * c - a[t].im * s;
        sim = sim + a[t].re * s + a[t].im * c;
        t = t + 1;
      }
      out.push(cxOf(sre, sim));
      k = k + 1;
    }
    return out;
  }
  // 位反序（不用位运算：一档一档减半，与 `n / 2` 那一路等价）
  int j = 0;
  int i = 1;
  while (i < n) {
    int bit = n / 2;
    while (bit > 0 && j >= bit) { j = j - bit; bit = bit / 2; }
    j = j + bit;
    if (i < j) {
      Complex t = a[i];
      a[i] = a[j];
      a[j] = t;
    }
    i = i + 1;
  }
  // 蝶形：段长 2、4、8 … n
  int len = 2;
  while (len <= n) {
    int half = len / 2;
    real ang = sign * tau / real(len);
    int base = 0;
    while (base < n) {
      int k = 0;
      while (k < half) {
        Complex w = cxPolar(1.0, ang * real(k));
        Complex u = a[base + k];
        Complex v = a[base + k + half].mul(w);
        a[base + k] = u.add(v);
        a[base + k + half] = u.sub(v);
        k = k + 1;
      }
      base = base + len;
    }
    len = len * 2;
  }
  return a;
}

private bool numIsPow2(int n) {
  if (n < 1) { return false; }
  int m = n;
  while (m % 2 == 0) { m = m / 2; }
  return m == 1;
}


