# ext/awk/examples/dict.awk —— 与 go / V 那两份 dict **同一件事**
#
# 期望输出逐行相同：1 / 3 / 4 / yes。
# awk 这一份压的是那一族里最特别的一条：**awk 的数组本来就是关联数组** ——
# 所以这门语言里没有"数组还是字典"这个问题（go 与 V 要靠字面量自带的标记分），
# 映射只要扫一遍"哪些名字带下标用过"，在块顶上补一格 `map-new` 就行（awk 没有声明）。
#
# 键一律是串，所以 `m["a"]` 的键就是那格串常量 —— 与 record 的"字段名是附属"正相反：
# **map 的键是值**，那正是这两族分开的理由之一。

BEGIN {
  m["a"] = 1
  m["b"] = 3
  print m["a"]
  print m["b"]
  m["c"] = 4
  print m["c"]
  if ("a" in m) {
    print "yes"
  }
}
