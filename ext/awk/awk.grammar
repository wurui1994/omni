;; ext/awk/awk.grammar —— POSIX awk（+ gawk 常用的那几格扩展）
;;
;; **状态：702 份 .awk 过 305，剩 61 处冲突。** 还没收工，但已经能用来读真 awk 了。
;; 一路量下来那条曲线、以及还欠的两类，记在文件末尾"还欠什么"。
;;
;; 语法照 **POSIX.1 那份公开的 awk 语法**写（IEEE Std 1003.1 的 "Grammar" 一节）。
;; 刻意**不从 gawk 的 awkgram.y 派生** —— 那份是 GPLv3，而这个仓库是 MIT；
;; 要读那份文件我们有 `omni glr table awkgram.y`（ADR-0034 的导入器）当场就能建表，
;; 不必也不该把派生物落进仓库。
;;
;; 这一份与 POSIX 那份 .y 的**一处形式差别**，也是它短了一半的原因：
;;
;;   **换行在 awk 里就是分号** —— 交给词法层那一格 `auto-semi`（glr/lex.js）。
;;   POSIX 那份语法里 `newline_opt` / `opt_newlines` / `terminator` 出现二十多次，
;;   全是"换行在这儿算不算收尾"这**同一件事**的手工版；把它挪到词法层，语法里就只剩
;;   一个 `";"`。词法层那条 `after` 名单说的正是 awk 的规矩：换行在**能收尾的记号**
;;   之后才算分号（`{`、`&&`、`||`、`,`、`do`、`else` 后面的换行不算）。
;;
;; 第二处要紧的决定：**正则字面量与除号**。`/re/` 和 `a / b` 在字符层一模一样，awk
;; 自己的词法器靠"上一个记号是不是操作数"分开它们。我们用同一条口径 ——
;; `(token ERE (not-after …) "/" … "/")`：前面刚出现过操作数时这条规则不参赛。
;;
;; 明说的三处不足（不猜）：
;;   1. `print a > b` 一律当**重定向**（awk 的规矩），`print (a > b)` 要自己加括号 ——
;;      与真 awk 一致；那条产生式上挂了 `(prefer 2)` 定胜负，见 print 那一段。
;;   2. `func_name (` 与 `name (` 不分：POSIX 靠词法器"名字后面紧跟左括号"发一个
;;      FUNC_NAME。我们不分，于是 `f (x)` 既可能是调用也可能是"f 接一个括号表达式"
;;      —— 后者交给 GLR 分叉，真歧义会报出来。
;;   3. gawk 的 `@include` / `@load` / 具名参数 / `|&` 协程不收。
;;
;; 与 gawk 那份 .y 的对照（同一台机器）：那份 352 状态 / 203 条产生式 / 58 处冲突；
;; 这一份见 DESIGN 那一行。两份都能建表，判据是**同一批 .awk 语料**谁认得多。

(grammar awk
  (tokens NAME NUMBER STRING ERE FUNC_NAME BUILTIN GETLINE NL)

  ;; **没有 (prec …) 声明** —— 优先级与结合性全在下面那串级联里（一级一个非终结符）。
  ;;
  ;; 这一条是量出来的：级联写完之后如果还留着优先级声明，那些声明会去**消掉**本该留给
  ;; GLR 的冲突。最典型的是 `print "x" > "f"`：这儿的 `>` 是重定向，而 `cmp -> cat ">" cat`
  ;; 也能移进它。两支都该活着（由 print 那条 `(prefer 2)` 定胜负），可只要 `>` 有优先级，
  ;; resolveConflicts 就会当场砍掉一支，剩下的那支走不通就报 "unexpected >"。
  ;; 换句话说：**级联与优先级声明不该混用**，混了就是两套消歧规则互相拆台。

  (start program)

  (lex
    ;; 空白**不含换行** —— 换行是记号（见下面 NL 那条）
    (skip (+ (set " \t\r")))
    ;; 续行：反斜杠 + 换行，整个吞掉（于是那处换行根本不出记号）
    (skip "\\" (? "\r") "\n")
    (comment "#" (* (not "\n")))
    ;; 换行是**真记号**（NL）。awk 里换行算不算收尾要看**语法位置**，不是看上一个记号：
    ;; `function f(a)` 后面那个换行不收尾，`x = f(a)` 后面那个收尾 —— 两处上一个记号都是
    ;; `)`。所以这一格不能交给 auto-semi（那是 go 的形状），只能照 POSIX 那样在语法里
    ;; 一处一处说"这儿允许换行"（下面的 opt-nl）。
    (token NL (+ (or "\n" (seq (set " \t\r") "\n"))))

    (token NUMBER (+ digit) (? "." (* digit)) (? (or "e" "E") (? (or "+" "-")) (+ digit)))
    (token NUMBER "." (+ digit) (? (or "e" "E") (? (or "+" "-")) (+ digit)))
    (token NUMBER "0" (or "x" "X") (+ hex))
    (string STRING "\"")

    ;; 正则字面量。**前面刚出现过操作数就不参赛** —— 那时那个 `/` 是除号。
    ;; 里头 `\/` 是转义掉的斜杠，`[...]` 里的斜杠也不算收尾（awk 的规矩），
    ;; 所以字符类单列一支。
    (token ERE (not-after NAME NUMBER STRING ERE ")" "]" "$" "++" "--")
      "/" (+ (or (not "/[\\\n") (seq "\\" any) (seq "[" (* (or (not "]\\") (seq "\\" any))) "]"))) "/")

    (token NAME (or alpha "_") (* (or alnum "_")))
    (keyword NAME GETLINE "getline")
    (keyword NAME BUILTIN
      "length" "substr" "index" "split" "sub" "gsub" "gensub" "match" "sprintf"
      "sin" "cos" "atan2" "exp" "log" "sqrt" "int" "rand" "srand"
      "tolower" "toupper" "system" "close" "fflush" "systime" "strftime" "mktime"
      "toupper" "asort" "asorti" "patsplit")
    (keyword NAME
      "BEGIN" "END" "function" "func" "if" "else" "while" "for" "do"
      "break" "continue" "next" "nextfile" "exit" "return" "delete" "in"
      "print" "printf")

    (op "**=" "^=" "+=" "-=" "*=" "/=" "%=" "==" "!=" "<=" ">=" "&&" "||" "++" "--"
        ">>" "!~" "**" "~" "=" "<" ">" "!" "?" ":" ";" "," "|"
        "{" "}" "(" ")" "[" "]" "$" "+" "-" "*" "/" "%" "^"))

  ;; ---- 程序 ------------------------------------------------------------------
  ;;
  ;; 一份 awk 程序是若干「项」：`模式 { 动作 }`、光一个模式、光一个动作，或一个函数定义。

  ;; 开头那一段收尾用 `opt-terms` 而不是 `opt-nl`：**一行注释出一个 NL 记号**，所以
  ;; 文件头连着几行注释就是连着几个 NL。`opt-nl` 只收一个 —— 那是量出来的第一号失败
  ;; （gawk 的 awklib/eg/lib/*.awk 差不多都以两行注释开头）。
  (rule program
    (-> (opt-terms items) (program $*2)))

  (rule opt-terms
    (-> () ())
    (-> (terms) ()))

  ;; 换行/分号在 awk 里都是收尾（POSIX 的 `terminator`），而**允许换行但不收尾**的位置
  ;; 要一处一处说 —— 那就是 opt-nl。这两格是这份语法里所有换行知识的全部。
  (rule opt-nl
    (-> () ())
    (-> (NL) ()))

  (rule term
    (-> (";") $1)
    (-> (NL) $1))

  (rule terms
    (-> (term) $1)
    (-> (terms term) $1))

  ;; **项之间必须有收尾**（换行或分号），只有最后一项可以省。这一条不是讲究，是消歧：
  ;; 若允许两个项直接挨着，`x==1 { print }` 就有两种读法 —— 一项（模式 + 动作）或者
  ;; 两项（光一个模式，再一个光动作）。真 awk 靠"同一行上的动作绑给前面那个模式"来定，
  ;; 而那件事在语法里的等价说法就是"两项之间要有收尾"。
  ;;
  ;; 也不要再写一条 `items terms`：那条与 `items item terms` 对着"一项 + 一个换行"
  ;; 会给出两条不同的推导（同一棵树、两条路），GLR 照样当真歧义报出来。
  ;; **右递归**的表，不是左递归。左递归写法（`items item terms | items item`）会让
  ;; "不带收尾"那一条在**每一处**都可用，于是 `y = x 2` 既能读成一条语句（连接）也能读成
  ;; 两条（`y = x` 和 `2`）—— 量出来的真歧义。右递归把"不带收尾"钉在**最后一格**：
  ;;   list -> 空 | 一项 | 一项 收尾 list
  ;; 于是"只有最后一项可以省收尾"变成语法上的事实，而不是一句注释。
  (rule items
    (-> () ())
    (-> (item) ($1))
    (-> (item terms items) ($1 $*3)))

  ;; `BEGIN` / `END` **必须**带动作（真 awk 也是），所以单列两条 —— 让它们走
  ;; `pattern` 那条的话，`BEGIN { … }` 又会有"一项还是两项"的两种读法。
  (rule item
    (-> ("BEGIN" opt-nl action) (rule (begin) $3))
    (-> ("END" opt-nl action) (rule (end) $3))
    (-> (pattern action) (rule $1 $2))
    (-> (pattern) (rule $1))
    (-> (action) (rule (always) $1))
    (-> ("function" NAME "(" params ")" opt-nl action) (fn $2 (params $*4) $7))
    (-> ("func" NAME "(" params ")" opt-nl action) (fn $2 (params $*4) $7)))

  (rule pattern
    (-> (expr) (when $1))
    (-> (expr "," opt-nl expr) (range $1 $4)))

  (rule params
    (-> () ())
    (-> (NAME) ($1))
    (-> (params "," opt-nl NAME) ($*1 $4)))

  (rule action
    (-> ("{" opt-nl stmts "}") (block $*3)))

  ;; ---- 语句 ------------------------------------------------------------------

  ;; 与 items 同一个形状、同一个理由（见那边的注释）
  (rule stmts
    (-> () ())
    (-> (stmt) ($1))
    (-> (stmt terms stmts) ($1 $*3)))

  (rule stmt
    (-> (simple) $1)
    (-> (action) $1)
    (-> ("if" "(" expr ")" opt-nl stmt) (if $3 $6))
    (-> ("if" "(" expr ")" opt-nl stmt terms "else" opt-nl stmt) (if $3 $6 (else $10)))
    (-> ("if" "(" expr ")" opt-nl stmt "else" opt-nl stmt) (if $3 $6 (else $9)))
    (-> ("while" "(" expr ")" opt-nl stmt) (while $3 $6))
    (-> ("do" opt-nl stmt terms "while" "(" expr ")") (do-while $3 $7))
    (-> ("do" opt-nl stmt "while" "(" expr ")") (do-while $3 $6))
    (-> ("for" "(" simple-opt ";" opt-nl expr-opt ";" opt-nl simple-opt ")" opt-nl stmt) (for $3 $6 $9 $12))
    (-> ("for" "(" NAME "in" NAME ")" opt-nl stmt) (for-in $3 $5 $8))
    (-> ("for" "(" "(" params ")" "in" NAME ")" opt-nl stmt) (for-in-multi (names $*4) $7 $10))
    (-> ("break") (break))
    (-> ("continue") (continue))
    (-> ("next") (next))
    (-> ("nextfile") (nextfile))
    (-> ("exit") (exit))
    (-> ("exit" expr) (exit $2))
    (-> ("return") (return))
    (-> ("return" expr) (return $2)))

  (rule simple-opt
    (-> () (none))
    (-> (simple) $1))

  (rule expr-opt
    (-> () (none))
    (-> (expr) $1))

  (rule simple
    (-> (expr) (expr $1))
    (-> ("delete" NAME "[" exprs "]") (delete $2 (subscript $*4)))
    (-> ("delete" NAME) (delete $2))
    (-> (print) $1))

  ;; `print a > b` 一律是重定向（awk 的规矩）。`(prefer 2)` 是给 GLR 驱动器定胜负用的：
  ;; 两支都归约成功时，重定向那一支赢 —— 想要比较就自己加括号 `print (a > b)`。
  (rule print
    (-> ("print") (print))
    (-> ("print" exprs) (print $*2))
    (-> ("printf" exprs) (printf $*2))
    (-> ("print" redirect) (print $2))
    (-> ("print" exprs redirect) (prefer 2) (print $*2 $3))
    (-> ("printf" exprs redirect) (prefer 2) (printf $*2 $3)))

  (rule redirect
    (-> (">" expr) (to $2))
    (-> (">>" expr) (append $2))
    (-> ("|" expr) (pipe-to $2)))

  ;; ---- 表达式：照 POSIX 那张级联表，一级一个非终结符 ------------------------------
  ;;
  ;; **不用优先级声明**，用级联。理由是 awk 的两处硬骨头都不是优先级能表达的：
  ;;
  ;;   1. **连接没有算符** —— 两个表达式挨着就是连接（`"x" a b`）。写成
  ;;      `expr -> expr expr` 加一格 CONCAT 优先级看着省事，量出来是灾难：那条规则在
  ;;      **每一个**能起头当操作数的记号上都是移进/归约冲突（574 处，GLR 当场被淹）。
  ;;   2. **一元与二元 `+` `-` 同形** —— `a - b` 是减法，`a (-b)` 是连接。区别只有一条：
  ;;      连接的**右边那格不许以一元号起头**。这句话没法写成优先级，只能写成语法。
  ;;
  ;; 所以照 POSIX 的办法：把"不许以一元号起头"那一支单独拉一条链出来（下面带 `-nu` 的
  ;; 那三格，nu = non-unary）。`cat -> cat add-nu` 里那个 `add-nu` 往下走到 `pow`，
  ;; 而 `pow` 只能以操作数起头 —— 一元号那一支进不来。
  ;;
  ;; 这一套要 **LALR(1)** 才成立：劈完之后 `pow` 既能归约成 `un`（`add` 那条链）也能归约成
  ;; `mul-nu`（`-nu` 那条链），靠的是"在 cat 的开头还是在 cat 的续接处"—— 那是两个不同的
  ;; LR 状态，前看集分得开。SLR 的全局 FOLLOW 分不开，这也是先前那 574 处的一半来源。

  (rule exprs
    (-> (expr) ($1))
    (-> (exprs "," opt-nl expr) ($*1 $4)))

  (rule expr
    (-> (assign) $1))

  ;; 赋值：右结合，左边必须是能存的地方（lvalue）
  (rule assign
    (-> (ternary) $1)
    (-> (lvalue "=" opt-nl assign) (assign "=" $1 $4))
    (-> (lvalue "+=" opt-nl assign) (assign "+=" $1 $4))
    (-> (lvalue "-=" opt-nl assign) (assign "-=" $1 $4))
    (-> (lvalue "*=" opt-nl assign) (assign "*=" $1 $4))
    (-> (lvalue "/=" opt-nl assign) (assign "/=" $1 $4))
    (-> (lvalue "%=" opt-nl assign) (assign "%=" $1 $4))
    (-> (lvalue "^=" opt-nl assign) (assign "^=" $1 $4))
    (-> (lvalue "**=" opt-nl assign) (assign "^=" $1 $4)))

  (rule lvalue
    (-> (NAME) (name $1))
    (-> (NAME "[" exprs "]") (index $1 (subscript $*3)))
    (-> ("$" prim) (field $2)))

  (rule ternary
    (-> (orx) $1)
    (-> (orx "?" opt-nl ternary ":" opt-nl ternary) (cond $1 $4 $7)))

  (rule orx
    (-> (andx) $1)
    (-> (orx "||" opt-nl andx) (bin "||" $1 $4)))

  (rule andx
    (-> (inx) $1)
    (-> (andx "&&" opt-nl inx) (bin "&&" $1 $4)))

  (rule inx
    (-> (matchx) $1)
    (-> (inx "in" NAME) (in $1 $3)))

  (rule matchx
    (-> (cmp) $1)
    (-> (matchx "~" cmp) (bin "~" $1 $3))
    (-> (matchx "!~" cmp) (bin "!~" $1 $3)))

  ;; 比较**不结合**（POSIX：`a < b < c` 不合法），所以两边都是 cat 而不是 cmp
  (rule cmp
    (-> (cat) $1)
    (-> (cat "<" cat) (bin "<" $1 $3))
    (-> (cat "<=" cat) (bin "<=" $1 $3))
    (-> (cat ">" cat) (bin ">" $1 $3))
    (-> (cat ">=" cat) (bin ">=" $1 $3))
    (-> (cat "==" cat) (bin "==" $1 $3))
    (-> (cat "!=" cat) (bin "!=" $1 $3))
    ;; `cmd | getline [var]` —— 管道只在 getline 左边出现，所以摆在这一级就够
    (-> (cmp "|" GETLINE) (getline (cmd $1)))
    (-> (cmp "|" GETLINE lvalue) (getline (cmd $1) (into $4))))

  ;; 连接：左结合，**右边那格不许以一元号起头**
  (rule cat
    (-> (add) $1)
    (-> (cat add-nu) (cat $1 $2)))

  (rule add
    (-> (mul) $1)
    (-> (add "+" mul) (bin "+" $1 $3))
    (-> (add "-" mul) (bin "-" $1 $3)))

  (rule add-nu
    (-> (mul-nu) $1)
    (-> (add-nu "+" mul) (bin "+" $1 $3))
    (-> (add-nu "-" mul) (bin "-" $1 $3)))

  (rule mul
    (-> (un) $1)
    (-> (mul "*" un) (bin "*" $1 $3))
    (-> (mul "/" un) (bin "/" $1 $3))
    (-> (mul "%" un) (bin "%" $1 $3)))

  (rule mul-nu
    (-> (pow) $1)
    (-> (mul-nu "*" un) (bin "*" $1 $3))
    (-> (mul-nu "/" un) (bin "/" $1 $3))
    (-> (mul-nu "%" un) (bin "%" $1 $3)))

  ;; 一元号与前缀增减。`^` 比一元号紧（`-2^2` 是 `-(2^2)`），所以 un 往下就是 pow
  (rule un
    (-> (pow) $1)
    (-> ("-" un) (neg $2))
    (-> ("+" un) (pos $2))
    (-> ("!" un) (not $2))
    (-> ("++" lvalue) (preinc $2))
    (-> ("--" lvalue) (predec $2)))

  ;; `^` 右结合，且右边可以带一元号（`2^-1`）
  (rule pow
    (-> (post) $1)
    (-> (post "^" un) (bin "^" $1 $3))
    (-> (post "**" un) (bin "^" $1 $3)))

  (rule post
    (-> (prim) $1)
    (-> (post "++") (postinc $1))
    (-> (post "--") (postdec $1)))

  (rule prim
    (-> (NUMBER) (num $1))
    (-> (STRING) (str $1))
    (-> (ERE) (re $1))
    (-> (NAME) (name $1))
    (-> (NAME "[" exprs "]") (index $1 (subscript $*3)))
    (-> ("$" prim) (field $2))
    (-> ("(" expr ")") (paren $2))
    ;; `(i, j) in arr` —— 多下标的成员测试
    (-> ("(" exprs "," opt-nl expr ")" "in" NAME) (in-multi (key $*2 $5) $8))
    (-> (NAME "(" args ")") (call $1 (args $*3)))
    (-> (BUILTIN "(" args ")") (call $1 (args $*3)))
    (-> (BUILTIN) (call $1 (args)))
    ;; getline 的四种"不带管道"形状。带 `<` 那两条 `(prefer 2)`：`getline < "f"` 里那个
    ;; `<` 是重定向不是比较，两支都能归约时重定向赢（与真 awk 一致）。
    (-> (GETLINE) (getline))
    (-> (GETLINE lvalue) (getline (into $2)))
    (-> (GETLINE "<" cat) (prefer 2) (getline (from $3)))
    (-> (GETLINE lvalue "<" cat) (prefer 2) (getline (into $2) (from $4))))

  (rule args
    (-> () ())
    (-> (exprs) $1)))

;; ---- 还欠什么（量出来的，不是待办清单） ------------------------------------------
;;
;; 301 状态 / 144 条产生式 / **61 处冲突**，702 份 .awk 过 **305**。一路量下来六刀：
;;
;;   33/702  608 冲突  起点：`expr -> expr expr` 一条规则管连接 + 一整套优先级声明
;;   31/702  574       建表器升到 LALR(1)（同一刀对 asy 是 46 -> 0，对 awk 只值 34 处）
;;   30/702   98       表达式改成 POSIX 那套级联 + `-nu` 链，**并删掉所有 (prec …) 声明**
;;  100/702  159       BEGIN/END 必须带动作；项之间必须有收尾
;;  239/702   61       项与语句的表改成**右递归**（"不带收尾"只许出现在最后一格）
;;  305/702   61       开头允许连着几个 NL（一行注释出一个 NL，文件头两行注释就卡住了）
;;
;; 这条曲线里最要紧的一句：**降冲突的不是建表器，是把歧义从"靠优先级压"改成"写进语法"**。
;; LALR 那一刀值 34 处，级联 + 右递归两刀值 513 处。优先级声明与级联**不该混用** ——
;; 混了就是两套消歧规则互相拆台（`print "x" > "f"` 里那个 `>` 就是这么被砍掉一支的）。
;; 这一条对后面 go / vlang / nim / c++ 比 LALR 本身更要紧。
;;
;; 剩下那 397 个是两类，都还没查：
;;   1. `(bin …)` vs `(cat …)` 的真歧义 —— 连接与二元 `+ -` 在某些形状上仍有两种读法
;;      （lib/bits2str.awk、lib/cliff_rand.awk）。
;;   2. `cat` vs `call` —— `f (x)` 是调用还是"f 连接一个括号表达式"。真 awk 靠词法器分：
;;      名字后**紧跟**左括号才发 FUNC_NAME。我们的词法器现在看不见"中间有没有空白"，
;;      所以要么给它加一格（`(not-after …)` 那套机制的近亲），要么认这笔账。
