// ext/polydraw/examples/basics.pss —— 与别的十几门那几份**同一件事**（tests/lower/run.js）
//
// 输出必须逐行相同：15 / 120 / 7 / ok。
//
// PolyDraw（EVAL）这一份压的是这门语言自己的三样：
//   * **没有声明、全是 double**：`acc = 0` 既是赋值也是"第一次出现"（adapter 扫一遍补 `let`）；
//   * **函数体最后那个表达式就是返回值**（`sumto` 末尾那个光秃秃的 `acc`）；
//   * **名字不分大小写**：`MAX2(3, 7)` 调的就是下面那个 `max2`。
//
// 串装不进变量（`eval.txt`），所以最后那个 `ok` 是 `printf` 里的字面量。
()
{
   printf("%g\n", sumto(5));
   printf("%g\n", factr(5));
   printf("%g\n", MAX2(3, 7));
   printf("ok\n");
}

sumto(n)
{
   acc = 0;
   for (i = 1; i <= n; i++) acc = acc + i;
   acc
}

factr(n)
{
   if (n == 0) { return 1; }
   return n * factr(n - 1);
}

max2(a, b)
{
   if (a > b) { return a; } else { return b; }
}
