// 只算不画那一档：EVAL 语言本体 —— 全是 double、名字不分大小写、`^` 是幂、`%` 是 fmod。
// 判据是 stdout（`printf`），不碰图形设备。
()
{
   printf("%g\n", 2 + 3 * 4);
   printf("%g\n", 2 ^ 10);
   printf("%g\n", -2 ^ 2);        // = (-2)^2 = 4：一元负号比 `^` 紧（eval.c:2019 的 negit）
   printf("%g\n", 7 % 3);
   printf("%g\n", sqrt(2) * sqrt(2));
   printf("%g\n", abs(-3) + sgn(-2) + unit(0));
   printf("%g\n", min(3, 5) + max(3, 5));
   printf("%g\n", int(-2.7));
   printf("%g\n", floor(-2.7));
   printf("%g\n", ceil(-2.7));
   printf("%g\n", fact(5));
   s = 0;
   for (i = 1; i <= 10; i++) s += i;
   printf("%g\n", s);
   n = 0;
   while (n < 3) n++;
   printf("%g\n", n);
   printf("%g\n", twice(21));
   printf("%g\n", TWICE(4));
}

twice(x)
{
   2 * x
}
