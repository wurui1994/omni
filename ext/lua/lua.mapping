;; ext/lua/lua.mapping —— Lua 的 CST → 图 映射（第一层：无条件）
;;
;; ## 模型
;;
;; 两层变换，接口是 28 格图节点：
;;
;; **第一层（这份文件）**：CST 标签 → 图节点。无条件、不查表。
;; 每个 CST 标签恰好一条规则。
;;
;; **第二层（tograph.js 的 rewrite）**：图 → 图。查上下文（MAPS）改写：
;;   field-get(x,"k") 其中 x 是 map → map-get(x,"k")
;;   index-get(x,i)   其中 x 是 map → map-get(x,i)
;;   等等。
;;
;; 这样第一层就是一张纯表——没有 native，没有逃逸口。
;;
;; ## 还不能做到纯第一层的标签
;;
;; 以下标签的树变换本身就有多路分支（不是查 MAPS 的问题）：
;;   table   — 查孩子标签判 record-new vs list-new
;;   bin     — and/or 走 branch（keepValue）、~= nil 窥孔
;;   local   — destructure + <close> + setmetatable
;;   assign  — dot/index/name 三路
;;   mcall   — 元表机器
;;   if      — elseif 链折叠
;;   fornum  — counted 展开
;; 这些标签暂时留在 tograph.js 的 switch 里（第二层之前的分析层）。
;; 它们的数量是 7，比之前的 14 少了一半。

(mapping lua
  (needs graph-nodes 28)

  ;; ================================================================
  ;; 一·叶子（7 格）—— 纯的，无条件
  ;; ================================================================
  (map (num $1)     (const (@ value (number $1))))
  (map (str $1)     (const (@ value $1)))
  (map (nil)        (const (@ value nil)))
  (map (true)       (const (@ value true)))
  (map (false)      (const (@ value false)))
  (map (name $1)    (ref   (@ name $1)))
  (map (paren $1)   $1)

  ;; ================================================================
  ;; 二·一元运算符（3 格）
  ;; ================================================================
  (map (neg $1)     (unop "-" $1))
  (map (not $1)     (unop "not" $1))
  (map (len $1)     (unop "len" $1))

  ;; ================================================================
  ;; 三·控制流与容器（5 格）
  ;; ================================================================
  (map (block $*1)  (region :body $*1))
  (map (do $1)      (region :body $*1))
  (map (break)      (loop-exit (@ kind "break")))
  (map (return $*1) (ret :value $*1))
  (map (while $1 $2) (loop :cond $1 :body $*2))

  ;; ================================================================
  ;; 四·函数（3 格）
  ;; ================================================================
  (map (fn $1)          (func $1))
  (map (localfn $1 $2)  (bind (@ name (name-of $1)) :init (func $2)))
  (map (globalfn $1 $2) (bind (@ name (name-of $1)) :init (func $2)))

  ;; ================================================================
  ;; 五·无条件的存取（2 格）—— 第二层再改写成 map-get/map-set
  ;; ================================================================
  (map (dot $1 $2)   (field-get :obj $1 (@ field (name-of $2))))
  (map (call $1 $2)  (call :fn $1 :args $*2))

  ;; ================================================================
  ;; 内建函数（2 格）
  ;; ================================================================
  (builtin print    (! print $*1))
  (builtin tostring (! concat $1))

  ;; ================================================================
  ;; 账
  ;;
  ;; 纯映射：22 格 CST 标签（无条件）
  ;; 还在 tograph.js switch 里：7 格（table/bin/local/assign/mcall/if/fornum）
  ;; + index（zeroBased）+ fndef（dot/method 两路）+ bnot（报错）+ fornum-step
  ;; 不在这儿的 3 个：repeat/forin/vararg（没接）
  ;; ================================================================
)
