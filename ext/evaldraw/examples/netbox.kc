// ext/evaldraw/examples/netbox.kc —— **`&一整块里的某一格`当"改得动的标量"** 与 **联网那一族**
//
// 两件事在同一份里，因为语料里它们是同一处代码：
// `games/asteroids/asteroids.kc:457` 的 `krnd(&lgs.krnd)` —— 把**结构体的一个字段**取地址
// 递给一个"形参是 `&x`"的函数。被调用的函数眼里 `kholdrand` 是个标量（`kholdrand = …`），
// 而调用方给的是"第 21 槽那一块里的第 4 格"。我们这条腿上 `&x` 落成"一格数组 + 一格偏移"
// （`名字$o`，见 adapter 的 `offName`），所以**函数体里的下标必须加上那格偏移**。
// 从前写死 `[0]`，于是 `krnd` 改的是那一块的**第 0 格**（asteroids 的 `gs.sprn`）：
// 精灵数被写成 25 亿，紧接着那句 `for(i=gs.sprn-1;i>=0;i--)` 就成了跑不完的循环。
//
// 联网那一族（`evaldraw.txt:1719-1790`）在单机上是**自己发自己收**：`NET_ALL` 的定义就是
// 「Send to everyone, **including self**」，`net_players`=1、`net_me`=0。
// `games/stratego.kc:26` 拿这一格当随机种子的同步点（收不到就死循环），
// 所以"回 0"不是能用的近似。偏差写在 `ext/polydraw/net-rt.js` 的头注里。
//
// 主函数在最前（这门语言的形状是"主函数 + 若干函数"）。

struct { a, b, c; } box_t;

static box_t s;
static buf[4];
static out[3];

()
{
   s.a = 1; s.b = 2; s.c = 3;
      //拿第 1 个字段的地址：函数改的必须是 s.b，别的两格一动不动
   bump(&s.b);
   printf("field=%g,%g,%g\n", s.a, s.b, s.c);
      //整块里的第 2 格同理（`&buf[2]`）
   buf[0] = 10; buf[1] = 20; buf[2] = 30; buf[3] = 40;
   bump(&buf[2]);
   printf("slot=%g,%g,%g,%g\n", buf[0], buf[1], buf[2], buf[3]);
      //取地址的标量（本地那种真箱子）：偏移是 0，与从前一样
   v = 7; bump(&v);
   printf("plain=%g\n", v);

      //联网：两参那一档 —— 发给 NET_ALL 会落回自己的收包队列，发件人是 net_me(0)
   printf("players=%g me=%g\n", net_players, net_me);
   printf("sent=%g\n", net_send(NET_ALL,123));
   from = -1; val = -1;
   printf("recv=%g from=%g val=%g\n", net_recv(&from,&val), from, val);
      //队列空了就回 0，且出参一格不动
   from = -1; val = -1;
   printf("empty=%g from=%g val=%g\n", net_recv(&from,&val), from, val);
      //NET_ALLELSE：单机没有别人 ⇒ 什么都没发出去，收也收不到
   printf("else=%g\n", net_send(NET_ALLELSE,9));
   printf("then=%g\n", net_recv(&from,&val));
      //三参那一档（一包多个值）；收进 buf 的**第 1 格起**，所以 buf[0] 不动
   out[0] = 5; out[1] = 6; out[2] = 7;
   printf("sent3=%g\n", net_send(NET_ALL,out,3));
   printf("recv3=%g\n", net_recv(&from,&buf[1],3));
   printf("got=%g,%g,%g,%g from=%g\n", buf[0], buf[1], buf[2], buf[3], from);
}

//形参是"改得动的标量"（`&x` 那一档）—— 拿到的可以是别人一整块里的某一格
bump (&x) { x = x + 100; return(0); }
