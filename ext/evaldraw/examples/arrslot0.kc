// ext/evaldraw/examples/arrslot0.kc —— **光秃秃的数组名字就是它的第 0 格**
//
// 口径是 `eval_bench`（真 kasm87 的机器码）：
//    (x){static a[4]; a[0]=3; a=7; return a[0];}          -> 7
//    (x){static a[4]={9,8,7,6}; return a;}                -> 9
//    (x){static a[2][3]; a[1][2]=4; a=5; return a[0][0];}  -> 5
//    (x){q=3; return q+g();} g(){static q[8]; q[0]=100; return q;} -> 103
//    (x){static a[4]={1,2,3,4}; h(&a); return a[0]*10+a[1];} h(&p){p=7;…} -> 72
// 变量就是一格槽，`a[i]` 是"槽 a 往后第 i 格"，`i` 不写就是 0 —— 读、写、算术、多维、
// 收整块的形参五处都一样。
//
// 语料里靠这一条的是 `demos/magsword.kc`：同一个函数里 `static dx[MAXDEVS]` 声明过，
// 后头 `dx = bx[i1]-bx[i0]` 又当标量使。我们从前报"两边要同型"，还把这一份记成
// "脚本自己写错了"（设计文档 §36.8 那一条已经改掉了）。
//
// **`shadow=` 那一行是这一格的反面**：`C.arrs` 是张跨函数的平表，照它判就会把主函数里的
// 标量 `q` 也当成数组（magsword 上第二次红就是这个）—— 要按**这一份函数**问（`C.arrHere`）。

static b[3] = {9,8,7};

()
{
   static a[4];
   a[0] = 3; a = 7;                             //写：`a` 等于 `a[0]`
   printf("slot0=%g\n", a[0]);

   printf("bare=%g calc=%g\n", b, b*2+1);        //读与算术：b 是 {9,8,7} ⇒ 9 / 19

   static m[2][3];
   m[1][2] = 4; m = 5;                          //多维：`m` 等于 `m[0][0]`
   printf("dim2=%g %g\n", m[0][0], m[1][2]);

   q = 3;                                       //这儿的 q 是标量，g() 里的 q 是数组
   printf("shadow=%g\n", q + g());

   h(&b);                                       //收整块的形参上也一样：改的是 b[0]
   printf("blk=%g %g\n", b, b[1]);
}

//别人函数里同名的数组 —— 不许影响主函数里那格标量 q
g() { static q[8]; q[0] = 100; return(q); }

//形参是"改得动的标量"（`&x` 那一档）：拿到的是 b 那一整块的第 0 格
h(&p) { p = 7; return(0); }
