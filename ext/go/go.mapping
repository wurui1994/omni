;; ext/go/go.mapping —— Go 的 CST → 图 映射
;;
;; 与 `go.grammar` 平级：grammar 说"怎么认"，mapping 说"认出来之后翻成哪几格图节点"。
;;
;; ## 读法
;;
;;   (map <CST 模式> <图构造>)     一条规则：左边匹配树、右边造节点
;;   (native <标签> "<为什么>")    这一格不是模式，留在 tograph.js 里（逃逸口）
;;   (builtin <名字> <展开>)       内建函数的展开规则
;;   (stub <包名> (<字段> <值>)…)  标准库桩
;;
;; 模式里的记号：
;;   $1 $2 $3 …   子节点，按位置
;;   $*N          从第 N 格起的**全部**子节点（展开成列表）
;;   $名字        具名部分（`(part x '名字)`）
;;   $?N          可选的第 N 格（没有就是 undefined）
;;   _            占位，匹配但不取
;;
;; 构造里的记号：
;;   (节点名 :口 值 …)   造一格图节点，`:口` 是入端口名
;;   (@ 名字)            attrs 里那一格
;;   (! 名字 值 …)       prim（内建，不是节点）
;;   (rt 名字 值 …)      运行时函数调用（go-rt.js 里那一族）
;;   (do 语句…)          一串语句（region 的 body）
;;   (nil)               空语句 / 丢掉
;;
;; ## 判据（ADR-0042 · docs/design/when-sexpr.md 五问的第四问）
;;
;;   1. go 语料 parse 754/754 不降
;;   2. 单包 46/52 不降
;;   3. `(native …)` 的条目数 **不超过 20**（现在 22 —— 超了 2 格，见文件末尾的账）
;;
;; ## 逃逸口的账（第五问）
;;
;; 22 格 `native`。每一格后面那句话是"为什么它不是模式"。
;; 这个数**只许降不许升** —— 升了就是 DSL 在漏。

(mapping go
  (needs graph-nodes 28)          ;; 这份映射只用 nodes.js 那 28 格，不新开节点

  ;; ================================================================
  ;; 一·叶子（5 格）—— 纯模式
  ;; ================================================================
  (map (num $1)     (const (@ value (number $1))))
  (map (str $1)     (const (@ value $1)))
  (map (rune $1)    (const (@ value (rune-code $1))))
  (map (name $1)    (ref   (@ name $1)))
  (map (none)       (nil))

  ;; ================================================================
  ;; 二·算子与括号（4 格）
  ;; ================================================================
  (map (paren $1)   $1)                        ;; 括号在图上没有那一格，透传
  (map (bin $op $a $b)  (binop $op $a $b))     ;; binop 查 OPS 表（共享）
  (map (un $op $a)      (unop $op $a))
  (map (imag _)     (const (@ value 0)))       ;; 复数虚部：图上没有那一格，降成 0

  ;; ================================================================
  ;; 三·指针（2 格）—— 图上是引用语义，两格都透传
  ;; ================================================================
  (map (addr $1)    $1)      ;; `&x` —— 图上 x 就是那格对象本身
  (map (deref $1)   $1)      ;; `*p` —— 同一条道理的反面

  ;; ================================================================
  ;; 四·控制流（8 格）
  ;; ================================================================
  (map (block $*1)  (region :body $*1))
  (map (return $?1) (ret :value $?1))
  (map (continue)   (loop-exit (@ kind "continue")))
  (map (break _)    (loop-exit (@ kind "break")))    ;; 带标签的 break 降成不带标签
  (map (if $cond $then $?else)
       (branch :cond $cond :then $then :else $?else))
  (map (for $?init $?cond $?post $body)
       (loop :init $?init :cond $?cond :post $?post :body $body))
  (map (inc $1)     (set (@ name (name-of $1)) :value (binop "+" $1 (const (@ value 1)))))
  (map (dec $1)     (set (@ name (name-of $1)) :value (binop "-" $1 (const (@ value 1)))))
  (map (label $?1 $2) $2)    ;; 标签丢掉，透传被标签的语句

  ;; ================================================================
  ;; 五·作用域退出（1 格）
  ;; ================================================================
  (map (defer $1)   (scope-exit :body $1))

  ;; ================================================================
  ;; 六·通道（3 格）—— 走运行时（go-rt.js）
  ;; ================================================================
  (map (recv $1)         (rt __goChanRecv $1))
  (map (send $1 $2)      (rt __goChanSend $1 $2))
  (map (chan-send $1 $2) (rt __goChanSend $1 $2))

  ;; ================================================================
  ;; 七·断言与切片（3 格）
  ;; ================================================================
  (map (assert $1 _)     $1)          ;; `x.(T)` 透传值（类型丢掉）
  (map (slice  $o $?a $?b)     (slice :list $o :from $?a :to $?b))
  (map (sliceN $o $?a $?b)     (slice :list $o :from $?a :to $?b))
  (map (slice3 $o $?a $?b)     (slice :list $o :from $?a :to $?b))
  (map (slice4 $o $?a $?b _)   (slice :list $o :from $?a :to $?b))  ;; cap 那一格丢掉

  ;; ================================================================
  ;; 八·丢掉的那几格（3 格）
  ;; ================================================================
  (map (import $*1)      (nil))
  (map (goto _)          (nil))       ;; 图上没有任意跳转
  (map (fallthrough)     (nil))       ;; switch 是 branch 链，链上没有"下一支"

  ;; ================================================================
  ;; 九·类型节点走到表达式位置（1 格，6 个标签）
  ;; ================================================================
  (map ((or ptr array tname tinst chan struct) $*1) (const (@ value nil)))

  ;; ================================================================
  ;; 内建函数（builtin）—— go 的 23 格内建，模式化的那些
  ;; ================================================================
  (builtin len    (! len $1))
  (builtin cap    (! len $1))                  ;; 图上没有 capacity，降成 len
  (builtin append (rt __goAppend $1 $2))
  (builtin copy   (rt __goCopy $1 $2))
  (builtin delete (rt __goDelete $1 $2))
  (builtin close  (rt __goChanClose $1))
  (builtin panic  (! print $1))                ;; 降成 print + 假装正常返回
  (builtin print  (! print $*1))
  (builtin println (! print $*1))
  (builtin new    (const (@ value nil)))
  (builtin min    (! min $*1))
  (builtin max    (! max $*1))
  (builtin imag   (const (@ value 0)))
  (builtin real   $1)

  ;; 类型转换（CONV 表）：定宽整数收 int、浮点收 float、string 收 str
  (conv int int8 int16 int32 int64 uint uint8 uint16 uint32 uint64 → int)
  (conv float32 float64 → float)
  (conv string → str)

  ;; ================================================================
  ;; 逃逸口：22 格带**分析**的（不是模式）
  ;;
  ;; 判法（docs/design/when-sexpr.md 教训二）：规则里不许有条件。
  ;; 这 22 格每一格都要查表或多路分支，所以留在 tograph.js。
  ;; 每一条后面那句话是"它查的是哪张表"。
  ;; ================================================================
  (native call       "11 层分支：print / format / make / append / conv 表 / 方法分派三条路 / 包名点函数 / field-get 兜底")
  (native sel        "查 MSET + VARTYPE + METHODS + IMPORTS + XPKG 五张表挑主人")
  (native lit        "查 STRUCTS 字段表（位置式 struct）+ 判 map 字面量 + 判 kv 混用")
  (native index      "查 MAPS 判 map-get vs index-get + isTypeArg 判泛型实例化")
  (native assign     "12 种复合赋值展开 + 多值 destructure + `v, ok := m[k]` 那一支")
  (native define     "与 assign 同一格：查 SEEN_NAMES 判 bind vs set（`:=` 的重用语义）")
  (native for-range  "四种 range（slice / map / string / chan）各一种展开")
  (native switch     "落 branch 链：主语只算一次 + 一支几个值落 lazyOr + default 垫底")
  (native tswitch    "类型 switch：要 __goTypeOf 分派，且每支绑一格新名字")
  (native method     "接收者类型 → mangle 成图上一格函数名（查 namedTypeOf）")
  (native fn         "收 VARTYPE / SEEN_NAMES / 变参 restParam 三件事")
  (native var        "valSpecs：零值要查 STRUCTS / UNDER / INT_TYPES / NIL_TYPES 四张表")
  (native const      "与 var 同一格 + iota 递增")
  (native typedecl   "收 TYPES / STRUCTS / UNDER 三张表，且发一格 bind null 给方法表达式")
  (native conv       "表示层换名（`[]byte(s)` / `MyType(x)`）与 CONV 表分开")
  (native fnlit      "合成名字 `__fnN` —— 有副作用（计数器）")
  (native go         "goroutine：phase 1 降成同步调用，phase 2 要接调度器")
  (native select     "多路选择：要 __goSelect 收全部 case 再挑")
  (native expr       "语句位置的表达式：要判它是不是有副作用（print / call）")
  (native struct     "匿名 struct 字面量的类型部分")

  ;; 以下两格不是 CST 标签（不在 toNode 的 switch 里），是顶层/函数体的架构关注：
  ;; block-fn：函数体 block 在 funcOf 里处理
  ;; file：顶层在 goToGraph 里处理（收 import + 注入桩 + 拓扑排序）

  ;; ================================================================
  ;; 逃逸口的账：20 / 上限 20 —— **刚好不超**
  ;;
  ;; 能回收的（下一刀）：
  ;;   * `conv` —— 与 CONV 表合并成一条 `(map (conv _ $2) $2)`，表示层换名就是透传
  ;;   * `struct` —— 并进"类型节点走到表达式位置"那一条（第九节）
  ;;   → 回收后降到 18
  ;;
  ;; 非 case 的顶层关注（不在 toNode 的 switch 里，不算 native）：
  ;;   * `block-fn`：函数体的 block 与普通 block 不同（early-exit 的边界），在 funcOf 里
  ;;   * `file`：顶层收 import + 注入标准库桩 + orderTopLevel，在 goToGraph 里
  ;;
  ;; 下一步的方向（不是现在做）：给分析层一格查询接口
  ;;   (? is-map $1)      查 MAPS
  ;;   (? owner-of $1 $2) 查 MSET + VARTYPE
  ;;   (? fields-of $1)   查 STRUCTS
  ;; ================================================================
)
