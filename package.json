{
  "name": "omni-lang",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Omni: cross-language parsing / multi-backend compilation architecture (stage0 bootstrap compiler, plain JS)",
  "bin": {
    "omni": "./src/cli.js"
  },
  "scripts": {
    "omni": "node src/cli.js",
    "build:self": "node src/cli.js bootstrap -o dist",
    "test": "node tests/run.js",
    "test:oracle": "node tests/oracle/run.js",
    "test:js": "node tests/js-roundtrip/run.js",
    "test:oir": "node tests/oir/run.js",
    "test:js-exec": "node tests/js-exec/run.js",
    "test:cabi": "node tests/cabi/run.js",
    "test:wat": "node tests/wat/run.js",
    "test:glr": "node tests/glr/run.js",
    "test:mir": "node tests/mir/run.js",
    "test:incr": "node tests/incr/run.js",
    "test:c": "node tests/c/run.js",
    "test:llvm": "node tests/llvm/run.js",
    "test:sexpr": "node tests/sexpr/run.js",
    "test:asy": "node tests/asy/run.js",
    "test:jnc": "node tests/jnc/run.js",
    "test:jit": "node tests/jit/run.js",
    "test:gpu": "node tests/gpu/run.js",
    "test:bootstrap": "node tests/bootstrap/run.js",
    "test:all": "node tests/all.js",
    "bench": "node bench/compare.js",
    "lint": "tsc --noEmit -p jsconfig.json"
  },
  "engines": {
    "node": ">=20"
  }
}
