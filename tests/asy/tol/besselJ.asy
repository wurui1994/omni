// gsl 的 Bessel J（整数阶）。放在 tol/ 而不是 cases/：这一层是双-双（double-double）
// 升幂级数，GSL 是 Chebyshev 拟合表 —— 两条路都对，末位差一两个。
//
// x 取到 21.2133 是因为 AiryDisk.asy 要的就是这一段（R=15，角上 r = 15√2 ≈ 21.2132）。
//
// 有两个点**故意没放进来**，因为在那儿差的是 GSL 不是这边（拿 mpmath 40 位当真值量的）：
//   J1(7)：真值 -0.004682823482345832699，这边印 -0.00468282348234583（对），
//     asy/GSL 印 -0.00468282348234585（末位差 2）；
//   J0(21.2133)：真值 -0.0002881938788843707857，这边 -0.000288193878884417
//     （差 4.6e-17），asy/GSL -0.000288193878884494（差 1.2e-16）—— 那是 J0 的零点
//     （21.2116）旁边，两边都只剩绝对精度，相对差 1e-13 量级，"末位差不超过 1"这条
//     表达不了它。要量这种点得换判据，所以这里不放，把话写在这儿。
import gsl;

real[] xs={0.25,0.5,1,2,3,5,6,10,12.5,15,18,21};
for(int i=0; i < xs.length; ++i) {
  write(J(0,xs[i]));
  write(J(1,xs[i]));
}
write(J(1,21.2133));   // AiryDisk 的角
// 高阶与负阶（J_{-n} = (-1)^n J_n）
write(J(2,3.0));
write(J(5,10.0));
write(J(20,21.0));
write(J(-1,2.0));
write(J(-2,3.0));
