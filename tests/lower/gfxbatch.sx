(module
  (main (do
    (let vs (arr real) (anew (arr real) (int 36)))
    (aset (var vs) (int 0) (real -0.8))
    (aset (var vs) (int 1) (real -0.8))
    (aset (var vs) (int 3) (real 1))
    (aset (var vs) (int 4) (real 1))
    (aset (var vs) (int 7) (real 1))
    (aset (var vs) (int 12) (real 0.8))
    (aset (var vs) (int 13) (real -0.8))
    (aset (var vs) (int 15) (real 1))
    (aset (var vs) (int 17) (real 1))
    (aset (var vs) (int 19) (real 1))
    (aset (var vs) (int 24) (real 0))
    (aset (var vs) (int 25) (real 0.8))
    (aset (var vs) (int 27) (real 1))
    (aset (var vs) (int 30) (real 1))
    (aset (var vs) (int 31) (real 1))
    (expr (gfxbatch (int 1) (int 3) (var vs)))
    (expr (gfxcall (str "refresh"))))))
