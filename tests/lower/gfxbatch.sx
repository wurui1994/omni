(module
  (main (do
    (let vs (arr real) (anew (arr real) (int 48)))
    (aset (var vs) (int 0) (real -0.8))
    (aset (var vs) (int 1) (real -0.8))
    (aset (var vs) (int 3) (real 1))
    (aset (var vs) (int 4) (real 1))
    (aset (var vs) (int 7) (real 1))
    (aset (var vs) (int 16) (real 0.8))
    (aset (var vs) (int 17) (real -0.8))
    (aset (var vs) (int 19) (real 1))
    (aset (var vs) (int 21) (real 1))
    (aset (var vs) (int 23) (real 1))
    (aset (var vs) (int 32) (real 0))
    (aset (var vs) (int 33) (real 0.8))
    (aset (var vs) (int 35) (real 1))
    (aset (var vs) (int 38) (real 1))
    (aset (var vs) (int 39) (real 1))
