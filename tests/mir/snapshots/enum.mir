  %37        IF       void    %36
  %38          RET      void    k4
  %39        END      void
  %40      END      void
  %41    END      void
  %42    NEG      f64     k5
  %43    RET      void    %42

func u_name(c:agg) -> str   2 slots, 15 insns
  %0     LOAD     agg     slot0:c
