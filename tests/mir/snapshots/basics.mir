func u_fib(n:i64) -> i64   1 slots, 14 insns
  %0     LOAD     i64     slot0:n
  %1     LT       i64     %0 k0
  %2     IF       void    %1
  %3       LOAD     i64     slot0:n
  %4       RET      void    %3
  %5     END      void
  %6     LOAD     i64     slot0:n
  %7     SUB      i64     %6 k1
  %8     CALL     i64     u_fib (%7)
  %9     LOAD     i64     slot0:n
  %10    SUB      i64     %9 k0
  %11    CALL     i64     u_fib (%10)
  %12    ADD      i64     %8 %11
  %13    RET      void    %12

func u_add(a:i64 b:i64) -> i64   2 slots, 4 insns
  %0     LOAD     i64     slot0:a
  %1     LOAD     i64     slot1:b
  %2     ADD      i64     %0 %1
  %3     RET      void    %2

func u_add__2(a:f64 b:f64) -> f64   2 slots, 4 insns
  %0     LOAD     f64     slot0:a
  %1     LOAD     f64     slot1:b
  %2     ADD      f64     %0 %1
  %3     RET      void    %2

func u_scale(x:i64 k:i64) -> i64   2 slots, 4 insns
  %0     LOAD     i64     slot0:x
  %1     LOAD     i64     slot1:k
  %2     MUL      i64     %0 %1
  %3     RET      void    %2

func u_sum(p:agg) -> i64   1 slots, 9 insns
  %0     LOAD     agg     slot0:p
  %1     COPY     agg     %0 struct:Point
  %2     STORE    void    %1 slot0:p
  %3     LOAD     agg     slot0:p
  %4     FLD      i64     %3 Point.x
  %5     LOAD     agg     slot0:p
  %6     FLD      i64     %5 Point.y
  %7     ADD      i64     %4 %6
  %8     RET      void    %7

