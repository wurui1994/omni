;; mir module  entry=omni_main
;; 8 funcs, 11 consts, 0 types, 0 globals, 1 ops
const k0     i64    0
const k1     i64    16
const k2     i64    5
const k3     i64    7
const k4     i64    1
const k5     i64    -1
const k6     i64    2
const k7     i64    6
const k8     i64    -9
const k9     i64    9
const k10    i64    10
op o0    print.int

func w__mix(a:i64 l1:i64) -> i64   3 slots, 8 insns
  %0     STORE    void    k0 slot2:l2
  %1     LOAD     i64     slot0:a
  %2     LOAD     i64     slot1:l1
  %3     MUL      i64     %1 %2
  %4     STORE    void    %3 slot2:l2
  %5     LOAD     i64     slot2:l2
  %6     ADD      i64     %5 k1
  %7     RET      void    %6

func w__tee() -> i64   1 slots, 5 insns
  %0     STORE    void    k0 slot0:x
  %1     STORE    void    k2 slot0:x
  %2     STORE    void    k3 slot0:x
  %3     ADD      i64     k3 k4
  %4     RET      void    %3

func w__sign(n:i64) -> i64   1 slots, 12 insns
  %0     LOAD     i64     slot0:n
  %1     LT       i64     %0 k0
  %2     IF       void    %1
  %3       RET      void    k5
  %4     ELSE     void
  %5       LOAD     i64     slot0:n
  %6       GT       i64     %5 k0
  %7       IF       void    %6
  %8         RET      void    k4
  %9       END      void
  %10    END      void
  %11    RET      void    k0

func w__cmps() -> i64   6 slots, 51 insns
  %0     STORE    void    k0 slot0:c
  %1     EQ       i64     k4 k4
  %2     IF       void    %1
  %3       STORE    void    k4 slot1:$sel1
  %4     ELSE     void
  %5       STORE    void    k0 slot1:$sel1
  %6     END      void
  %7     LOAD     i64     slot1:$sel1
  %8     STORE    void    %7 slot0:c
  %9     LOAD     i64     slot0:c
  %10    NE       i64     k4 k6
  %11    IF       void    %10
  %12      STORE    void    k4 slot2:$sel2
  %13    ELSE     void
  %14      STORE    void    k0 slot2:$sel2
  %15    END      void
  %16    LOAD     i64     slot2:$sel2
  %17    ADD      i64     %9 %16
  %18    STORE    void    %17 slot0:c
  %19    LOAD     i64     slot0:c
  %20    LE       i64     k4 k4
  %21    IF       void    %20
  %22      STORE    void    k4 slot3:$sel3
  %23    ELSE     void
  %24      STORE    void    k0 slot3:$sel3
  %25    END      void
  %26    LOAD     i64     slot3:$sel3
  %27    ADD      i64     %19 %26
  %28    STORE    void    %27 slot0:c
  %29    LOAD     i64     slot0:c
  %30    GE       i64     k4 k4
  %31    IF       void    %30
  %32      STORE    void    k4 slot4:$sel4
  %33    ELSE     void
  %34      STORE    void    k0 slot4:$sel4
  %35    END      void
  %36    LOAD     i64     slot4:$sel4
  %37    ADD      i64     %29 %36
  %38    STORE    void    %37 slot0:c
  %39    LOAD     i64     slot0:c
  %40    EQ       i64     k0 k0
  %41    IF       void    %40
  %42      STORE    void    k4 slot5:$sel5
  %43    ELSE     void
  %44      STORE    void    k0 slot5:$sel5
  %45    END      void
  %46    LOAD     i64     slot5:$sel5
  %47    ADD      i64     %39 %46
  %48    STORE    void    %47 slot0:c
  %49    LOAD     i64     slot0:c
  %50    RET      void    %49

func w__even(n:i64) -> i64   1 slots, 9 insns
  %0     LOAD     i64     slot0:n
  %1     EQ       i64     %0 k0
  %2     IF       void    %1
  %3       RET      void    k4
  %4     END      void
  %5     LOAD     i64     slot0:n
  %6     SUB      i64     %5 k4
  %7     CALL     i64     w__odd (%6)
  %8     RET      void    %7

func w__odd(n:i64) -> i64   1 slots, 9 insns
  %0     LOAD     i64     slot0:n
  %1     EQ       i64     %0 k0
  %2     IF       void    %1
  %3       RET      void    k0
  %4     END      void
  %5     LOAD     i64     slot0:n
  %6     SUB      i64     %5 k4
  %7     CALL     i64     w__even (%6)
  %8     RET      void    %7

func w__start() -> void   0 slots, 17 insns
  %0     CALL     i64     w__mix (k7 k3)
  %1     CALLOP   void    print.int (%0)
  %2     CALL     i64     w__tee ()
  %3     CALLOP   void    print.int (%2)
  %4     CALL     i64     w__sign (k8)
  %5     CALLOP   void    print.int (%4)
  %6     CALL     i64     w__sign (k0)
  %7     CALLOP   void    print.int (%6)
  %8     CALL     i64     w__sign (k9)
  %9     CALLOP   void    print.int (%8)
  %10    CALL     i64     w__cmps ()
  %11    CALLOP   void    print.int (%10)
  %12    CALL     i64     w__even (k10)
  %13    CALLOP   void    print.int (%12)
  %14    CALL     i64     w__odd (k10)
  %15    CALLOP   void    print.int (%14)
  %16    RET      void

func omni_main() -> void   0 slots, 2 insns
  %0     CALL     void    w__start ()
  %1     RET      void
