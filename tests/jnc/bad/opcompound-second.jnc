// 第一百五十二刀留下的那条界：一格主人身上**第二条**同一个复合赋值算符。
//
// 挑哪一条要按实参类型挑（jancy 那边是 chooseOverload），而那与第八十刀的同元重载是同一笔账 ——
// `operator :=` 那一处（第一百三十刀）也是这么划的，两处共一条口径：**明说不收第二个，不猜**。
//
// 语料里的原样：`std.String` 写了三条 `operator += `（string_t / utf16_t const* / utf32_t，
// std_String.jnc:60-70）。这一刀之后第一条落得下来，第二、三条报这一句 ——
// 一起编 std 那张榜上那两条就是它们。

struct Acc {
	int m_sum;

	int operator += (int v) {
		m_sum = m_sum + v;
		return m_sum;
	}

	int operator += (double v) {
		m_sum = m_sum + (int)v;
		return m_sum;
	}
}

int main() {
	Acc a;
	a += 1;
	printf("%d\n", a.m_sum);
	return 0;
}
