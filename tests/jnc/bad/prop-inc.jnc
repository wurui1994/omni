// 属性当"一格可写的内存"用（ADR-0016 第六十九刀的边界）。
// `b.m_v++` 与 `&b.m_v` 都要求那一格**有地址、能就地改**，而属性的读写各是一次调用 ——
// jancy 那边 `++` 是"读一次、加一、写一次"（与复合赋值同一条），这一层的自增降成方言的一句。
// 这一条本来报的是"Box 没有字段 'm_v'"：那是**认错了人** —— 成员在，只是它不是一格内存。
class Box {
	int m_r;

	int property m_v;

	construct() {
		m_r = 1;
	}

	int m_v.get() {
		return m_r;
	}

	void m_v.set(int x) {
		m_r = x;
	}
}

int main() {
	Box b;
	b.m_v++;
	return 0;
}
