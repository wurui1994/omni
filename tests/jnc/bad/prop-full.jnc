// 完整声明式的属性（ADR-0016 第七十刀的边界）。
// `property p { … }`（prop_full.rst:15）里那对花括号**开的是一层命名空间**：属性自己的字段、
// 取值器、可以重载的几个存值器都写在里头。在语法这一层它是一格"说明符位置没有类型、只有
// property 那个词"的带体 fn-def —— 落到 specs 那儿报的是"这条声明没有类型"，认错了人。
// 要接它得先有"属性也是一层命名空间"，加上存值器的重载决议，是自己一刀。
property g_full {
	int m_x;

	int get() {
		return m_x;
	}

	void set(int x) {
		m_x = x;
	}
}

int main() {
	return 0;
}
