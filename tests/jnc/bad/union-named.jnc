// 第一百一十刀的界，第二百一十三刀往里挪了一格：**顶层**带名字的 union 现在收了
// （`cases/166-unionnamed.jnc`），可**写在结构体里**的那一格照旧不收 —— 它要的是
// "结构体也是一层命名空间"（`H.U` 这个类型名要查得着），与 `结构体里的嵌套类型` 剩下
// 那一份是同一格。匿名的那一格（`cases/102-union.jnc`）落得下来是因为它的成员直接摊进
// 外层结构体的字段表。
struct H {
	int m_code;

	union U {
		int m_a;
		int m_b;
	}
}

int main() {
	H* h = new H;
	h.m_code = 3;
	printf("%d\n", h.m_code);
	return 0;
}
