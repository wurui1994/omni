// printf 不以 `\n` 收尾的那种，与 `%c`（ADR-0016 第四刀）。
//
// 原先这两样都被拒了，理由是"方言里没有不换行的输出"与"方言里没有整数 -> 一个字符的串"。
// 那是让语言向方言妥协，反了：方言这一刀因此长出了 `(write E)`，并把早就存在的
// `(chr E)` 露到核心方言这一层（另外四条腿一直有它，漏的只是 LLVM 那一行 ABI）。
//
// 期望输出的出处：
//   - jancy 的 `printf` 就是 C 的那一套（stdlib 里是 vararg 的 printf），不补换行 ——
//     所以 `printf("a"); printf("b"); printf("c\n");` 是一行 `abc`
//   - `%c` 印一个字符：72 105 33 是 'H' 'i' '!'（ASCII）
//   - `%d` 收 bool：jancy 的 bool 底下是 int8，印 1 / 0
//   - 缓冲不能把顺序打乱：`write` 与 `print` 在每条腿上共用同一个输出缓冲区
//     （JS 的 $print_raw / 解释器的 printRaw / C 的 printf 都写同一个 stdout），
//     所以 `x=7 y=` 后面接上的 `8 done` 必须在同一行

// 计一次数再回新值。宽度那一格用它来盯"实参只算一遍"。
int bump(int* c) {
    *c = *c + 1;
    return *c;
}

int main() {
    // 一行分三次印出来
    printf("a");
    printf("b");
    printf("c\n");

    // 一行里多个值，靠不换行的段拼起来
    int i = 0;
    for (i = 1; i <= 3; i++)
        printf("%d ", i);
    printf("\n");

    // %c
    printf("%c%c%c\n", 72, 105, 33);
    // char 就是整数，所以能算
    int ch = 65;
    printf("%c%c\n", ch, ch + 25);

    // 不换行的段与换行的段交替，顺序不能乱
    printf("x=%d y=", 7);
    printf("%d done", 8);
    printf("\n");

    // %d 收 bool
    int n = 3;
    printf("%d %d\n", n > 2, n > 9);

    // %% 与空的一行
    printf("100%%\n");
    printf("\n");

    // ---- 宽度与标志（ADR-0016 第五刀）。这一段是**逐字节对着 C 的 printf 量的**：
    //        printf '[%5d]\n[%-5d]\n[%05d]\n[%05d]\n[%5s][%-5s]\n[%3d]\n' 42 42 42 -42 ab ab 123456
    //      给的就是下面这六行。`%05d` 印负数是 `-0042`（零补在**符号后面**）——
    //      这一条是 C 的规矩，不是我们编的。
    printf("[%5d]\n", 42);
    printf("[%-5d]\n", 42);
    printf("[%05d]\n", 42);
    printf("[%05d]\n", -42);
    printf("[%5s][%-5s]\n", "ab", "ab");
    // 本来就比宽度长：不截断（C 也不截）
    printf("[%3d]\n", 123456);
    // 宽度也管 %c 与 %f
    printf("[%5c][%8f]\n", 65, 1.5);
    // 宽度那一格要多次读那段文本，所以降级时会先落成一个局部量 ——
    // 直接内联的话这个 bump() 会被调两遍（补零那一支是四遍）。这两行就是在盯那件事：
    // 计数器最后必须是 1。
    int* cnt = new int[1];
    printf("[%5d]\n", bump(cnt));
    printf("calls=%d\n", *cnt);

    printf("end\n");

    return 0;
}
