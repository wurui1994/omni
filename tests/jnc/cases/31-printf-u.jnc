// `%u`（ADR-0016 第三十二刀）—— 转换字符那一族里最便宜的一格：**方言一个字都没长**。
//
// 理由是它与第七刀的 `%x` 是同一条规则：C 把实参当 unsigned 读，位数是**默认实参提升
// 之后**那一格。所以 `char d = -56; printf("%u", d)` 是 `4294967240`（提到 int 之后按
// 32 位无符号读），与那一行的 `%x` 给 `ffffffc8` 是同一个数的两种写法。方言的
// `(sbase E 进制)` 本来就把实参当无符号 64 位读、进制那一格也不限于 8 / 16 ——
// `%u` 就是那条路子上进制换成 10。
//
// 期望输出的**出处**：C。逐条对照下面这份，`cc -O0 -std=c99` 编出来跑：
//
//   #include <stdbool.h>
//   #include <stdio.h>
//   int main(void) {
//     printf("u1=%u\n", 0);
//     printf("u2=%u\n", 7);
//     int c = -1;                printf("u3=%u\n", c);
//     signed char d = -56;       printf("u4=%u\n", d);
//     short e = -2;              printf("u5=%u\n", e);
//     long long f = -1;          printf("u6=%llu\n", f);
//     long long g = 3735928559;  printf("u7=%llu\n", g);
//     printf("p1=[%.3u] [%.0u] [%.0u] [%.5u]\n", 7, 0, 7, 42);
//     printf("w1=[%5u] [%-5u] [%05u] [%8.5u] [%-8.5u] [%08.5u]\n", 7, 7, 7, 42, 42, 42);
//     printf("s1=[%*u] [%.*u] [%0*u] [%0*.*u]\n", 6, 42, 4, 42, 6, 42, 8, 4, 42);
//     printf("m1=%u %d %x %o\n", 255, 255, 255, 255);
//     bool b = 1;                printf("b1=%u\n", b);
//     return 0;
//   }
//
// 与那份 C 的两处写法差别（不是语义差别，与 07-hex.jnc 那两处同）：`signed char`
// 与 `%llu`（C 那边 64 位实参要长度修饰符，而这一层的 `%u` 位数从**类型**上取）。
//
// 标志那一半照 `%d` / `%x` 那一套走，不用另写：精度让 `0` 标志作废（`%08.5u` 是
// `   00042`）、精度 0 印 0 收的是**空串**（`p1` 第二格）、`*` / `.*` 都通。
// `+` / 空格 / `#` 在 `%u` 上是 C 的**未定义行为**（clang: "flag '#' results in undefined
// behavior with 'u' conversion specifier"），照旧拒 —— 与 `%+x` 是同一种拒。
int main() {
    // 一、正数与零
    printf("u1=%u\n", 0);
    printf("u2=%u\n", 7);

    // 二、负数当 unsigned 读，**位数是提升之后那一格**（与 `%x` 同一条）
    int c = -1;
    printf("u3=%u\n", c);
    char d = -56;
    printf("u4=%u\n", d);
    short e = -2;
    printf("u5=%u\n", e);
    long f = -1;
    printf("u6=%u\n", f);
    long g = 3735928559;
    printf("u7=%u\n", g);

    // 三、精度：补零到 N 位，而 `%.0u` 印 0 是空串
    printf("p1=[%.3u] [%.0u] [%.0u] [%.5u]\n", 7, 0, 7, 42);

    // 四、宽度与标志（精度一写，`0` 就作废）
    printf("w1=[%5u] [%-5u] [%05u] [%8.5u] [%-8.5u] [%08.5u]\n", 7, 7, 7, 42, 42, 42);

    // 五、`*` 与 `.*`
    printf("s1=[%*u] [%.*u] [%0*u] [%0*.*u]\n", 6, 42, 4, 42, 6, 42, 8, 4, 42);

    // 六、同一行里与别的转换混着（同一个 255 的四种样子）
    printf("m1=%u %d %x %o\n", 255, 255, 255, 255);

    // 七、bool 印 1（jancy 的 bool 底下是 int8）
    bool b = true;
    printf("b1=%u\n", b);
    return 0;
}
