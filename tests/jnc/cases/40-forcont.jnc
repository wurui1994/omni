// 带步进的 `for` 里的 `continue`（ADR-0016 第四十二刀）。以前当场拒 —— 方言里没有 `for`，
// 步进被摊到体的末尾，而 `cont` 跳的是循环头，直接接会漏掉一次步进（成死循环或少走一步）。
//
// 现在给体套一圈**一次性**循环：
//
//   (while COND (do (while (bool true) (do BODY (brk))) STEP))
//
// `continue` 变成那圈的 `(brk)`，落点正好在 STEP 之前 —— 与 C 的 for 逐格一致。只有"体里真有
// 一条 continue 指着这一层、而这一层又带步进"时才套（多一圈就多一层，白套会让别处的层号变长）。
//
// 七格，每一格都拿 `cc -O0 -std=c99` 的孪生量过（五条腿也各自与它相同）：
//   a：最常见的那一格。b：步进是一串（`i++, k += 2`）—— continue 之后两条都要跑。
//   c：内层 while 里 `continue2` 指着外层带步进的 for。d：两层都是带步进的 for，
//   `continue2` 与 `continue` 混着写（一次性那两圈嵌起来，层号要数对）。
//   e：`break` 还是出**整个** for，不是只出那圈一次性的。f：switch 在带步进的 for 里 ——
//   `continue` 指着 for（switch 不算一层），`break` 只出 switch。g：没有步进的 for 走老路，
//   直接 `(cont)` 回到判断。
//
// 与那份 C 的唯一写法差别：C 没有 `continue2`，c 与 d 那两格只能写 goto。

int f1() {
    int acc = 0;
    for (int i = 0; i < 5; i++) {
        if (i == 2)
            continue;
        acc += i;
    }
    return acc;
}

int f2() {
    int acc = 0;
    int k = 0;
    for (int i = 0; i < 5; i++, k += 2) {
        if (i % 2 == 0)
            continue;
        acc += i * 10;
    }
    return acc + k;
}

int f3() {
    int acc = 0;
    for (int i = 0; i < 4; i++) {
        int j = 0;
        while (j < 3) {
            j++;
            if (j == 2)
                continue2;
            acc += i;
        }
        acc += 100;
    }
    return acc;
}

int f4() {
    int acc = 0;
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (j == 1)
                continue;
            if (i == 1)
                continue2;
            acc += i * 10 + j;
        }
        acc += 1;
    }
    return acc;
}

int f5() {
    int acc = 0;
    for (int i = 0; i < 9; i++) {
        if (i == 2)
            continue;
        if (i == 5)
            break;
        acc += i;
    }
    return acc;
}

int f6() {
    int acc = 0;
    for (int i = 0; i < 5; i++) {
        switch (i) {
        case 1:
            continue;
        case 3:
            acc += 30;
            break;
        default:
            acc += 1;
        }
        acc += 100;
    }
    return acc;
}

int f7() {
    int acc = 0;
    int i = 0;
    for (; i < 5;) {
        i++;
        if (i == 3)
            continue;
        acc += i;
    }
    return acc;
}

int main() {
    printf("a=%d\n", f1());
    printf("b=%d\n", f2());
    printf("c=%d\n", f3());
    printf("d=%d\n", f4());
    printf("e=%d\n", f5());
    printf("f=%d\n", f6());
    printf("g=%d\n", f7());
    return 0;
}
