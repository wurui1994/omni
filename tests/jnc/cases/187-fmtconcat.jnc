// 相邻的几段 `$"…"` 拼在一起是**一格**格式化字面量（第二百四十九刀）。
//
// jancy 的 `literal` 是 `literal_atom+`，几段的文本进的是**同一个** Literal 缓冲，
// `m_fmtIndex` 也只有一格（Parser.cpp:3496）—— 所以序号在段与段之间**接着数**。
// 语料里的原样（log_MonitorRepresenter.jnc:28，五段拼一句带实参表）：
//
//   representation.addHyperText(
//       $"%1\n"
//       $"File name:\t%2%3\n"
//       …(messageText, …));

int main() {
	int n = 42;
	string_t s = "abc";

	// 三段拼一句、共用一张实参表：%1 / %2 是表里的第 1、2 个
	printf($"a%1-" $"b%2-" $"c%1\n"(n, s));

	// 光写 spec 的那种（序号是"上一个用过的 + 1"）也跨段接着数
	printf($"x%d " $"y%d\n"(7, 8));

	// 段里混着 `$id` 内嵌（不占实参位）与 `%N`（占）
	printf($"n=$n " $"s=%1\n"(s));

	// 一段自己带实参表、另一段是纯文本
	printf($"[%1]" $"!\n"(n));
	return 0;
}
