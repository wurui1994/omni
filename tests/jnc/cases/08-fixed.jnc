// `%f` 与 `%.Nf`（ADR-0016 第八刀）。方言这一刀长出 `(sfix E N)`。
//
// 这一格补的是一处**静默的差别**：第八刀之前 `%f` 降成方言的 `tostr`（也就是 `%.6g`），
// 于是 `printf("%f", 1.5)` 印 `1.5` 而 C 印 `1.500000`、`double d = 3` 印 `3` 而 C 印
// `3.000000`。C 的 `%f` 是 `%.6f`（**默认精度 6**），不是"把这个数印出来"。
//
// 舍入定的是 **C 那一边：就近取偶**（IEEE-754 的默认舍入）。这一条必须挑一边，因为两条
// 实现路子在**恰好一半**上本来不一样：`0.125` 到两位，C 给 `0.12`，JS 的 `toFixed` 给
// `0.13`（ECMA-262 规定取较大的 n）。挑 C 的理由是 jancy —— 它的 printf 底下就是 C 的
// printf。所以 JS 那侧不能用 toFixed，得按精确值用 BigInt 算（native.js 的 fmtFixed）。
//
// 期望输出的**出处**：C。逐条对照下面这份，`cc -O0` 编出来跑：
//
//   #include <stdio.h>
//   int main(void) {
//     printf("d1=%f\n", 1.5);
//     printf("d2=%f\n", 3.0);
//     printf("p0=%.0f\n", 2.5);
//     printf("p1=%.1f\n", 0.25);
//     printf("p2=%.2f\n", 0.125);
//     printf("p3=%.2f\n", 0.375);
//     printf("p4=%.3f\n", 12345.6789);
//     printf("p5=%.10f\n", 0.1);
//     printf("n1=%.2f\n", -1.5);
//     printf("n2=%.0f\n", -0.4);
//     double x = 1.0 / 3.0;
//     printf("c1=%.5f\n", x);
//     printf("c2=%.2f\n", x * 3.0);
//     printf("w1=[%8.2f]\n", 1.5);
//     printf("w2=[%-8.2f]\n", 1.5);
//     printf("w3=[%08.2f]\n", -1.5);
//     printf("w4=[%08.2f]\n", 1.5);
//     printf("m1=%.2f %d %s\n", 2.5, 7, "ok");
//     return 0;
//   }
int main() {
    // 一、`%f` 就是 `%.6f`
    printf("d1=%f\n", 1.5);
    double d = 3.0;
    printf("d2=%f\n", d);

    // 二、恰好一半：就近取偶。2.5 -> 2（偶数不进）、0.125 -> 0.12、0.375 -> 0.38
    printf("p0=%.0f\n", 2.5);
    printf("p1=%.1f\n", 0.25);
    printf("p2=%.2f\n", 0.125);
    printf("p3=%.2f\n", 0.375);

    // 三、别的精度
    printf("p4=%.3f\n", 12345.6789);
    printf("p5=%.10f\n", 0.1);

    // 四、负数（含"绝对值舍到 0 之后符号还在"这一格：-0.4 到 0 位是 `-0`）
    printf("n1=%.2f\n", -1.5);
    printf("n2=%.0f\n", -0.4);

    // 五、运行期算出来的值
    double x = 1.0 / 3.0;
    printf("c1=%.5f\n", x);
    printf("c2=%.2f\n", x * 3.0);

    // 六、宽度与精度一起用（补零那一支把符号摘在前面：`[-0001.50]`）
    printf("w1=[%8.2f]\n", 1.5);
    printf("w2=[%-8.2f]\n", 1.5);
    printf("w3=[%08.2f]\n", -1.5);
    printf("w4=[%08.2f]\n", 1.5);

    // 七、混着别的转换
    printf("m1=%.2f %d %s\n", 2.5, 7, "ok");
    return 0;
}
