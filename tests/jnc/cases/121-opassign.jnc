// 第一百三十刀：赋值算符 **`operator :=`**。语料里 11 处，全在 std 那一批
// （`std_String` / `std_Buffer` 那一族：`size_t errorcode operator := (utf16_t const* p)`）——
// 它是 `--group` 那张榜上 `限定名或特殊名的声明符` 那 35 处里最大的一格。
//
// 语法本来就认它（`(operator :=)` 是声明符的一格核心），所以这一刀全在降级那一侧：
//   1. `specialCore` 把它当特殊成员回（`'operator :='`）—— 于是 aggHoist 提得动、typeDecl 跳得过；
//   2. `fnSig0` 那儿**要照常问 specs**：它是有返回类型的。这一格先前漏着，返回类型被吞成 void，
//      体里的 `return m_v` 于是报成"main 里 `return` 一个非 0 的值"—— 认错了人，量出来的一个洞；
//   3. `opAssignSig` 登记成一格方法（`Owner$op$assign`，`this` 当第一个形参）；
//   4. 赋值那一处按**左边那一格的类型**去找它。
//
// 三条判据写清（都在 lower.js 那处注里）：只在 `=` 上认（`+=` 那一族是别的算符，还不收）；
// 右边**同型**时不认（那是"抄一份"，是拷贝不是转换）；右边要对得上它那**一个**形参。
// 一格类型上只收一个 `operator :=` —— 多个要按实参类型挑，那与第八十刀的同元重载是同一笔账。
//
// 这一刀顺手让**类的变量能赋值**了（在有 `operator :=` 的那一格上）：第五十二刀那句
// "类的变量赋不了值"照旧管别的类 —— 算符要盖掉的正是那一句，所以这一问排在它之前。
//
// 尺子 `/tmp/c127.c`：C 里没有算符重载，手写的是"编译器该替你挑的那个调用" —— 那正是这一刀做的事。
// 同一串数（10 / 65 65 / 65 66）。

class C {
	int m_v;

	void operator := (int x) {
		m_v = x * 2;
	}
}

struct S {
	int m_v;

	// 有返回类型的那一种（语料里 `size_t errorcode operator :=` 就是这个形状）
	int operator := (char c) {
		m_v = c;
		return m_v;
	}
}

int main() {
	C* c = new C;
	c = 5;                               // 类的变量赋值：算符盖掉了第五十二刀那一句
	printf("%d\n", c.m_v);

	S a;
	a = 65;                              // 走算符
	S b;
	b = a;                               // **同型**：照旧抄一份，不走算符
	printf("%d %d\n", a.m_v, b.m_v);

	b = 66;                              // 抄完再走一次算符
	printf("%d %d\n", a.m_v, b.m_v);
	return 0;
}
