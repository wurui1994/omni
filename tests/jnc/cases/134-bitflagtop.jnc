// 第一百四十二刀：`bitflag enum` 的"下一格"按**无符号那一面**算。
//
// 第四十七刀在这儿立了一条界，话是"里的负值 —— jancy 那边 `2 << getHiBitIdx64(负数)` 是 C++ 的
// 未定义行为，没有可对的答案"。**那句话错了两处**：
//
//   1. `getHiBitIdx64` 收的是 `uint64_t` —— jancy 那一步从来没见过负数。所谓"负值"是这一层
//      自己把值按 signed 存下来之后看出来的（`Foldable = 0x8000000000000000` 在 64 位那一格里
//      就是最高位，signed 看是负数）。那个值本身**完全合法**；
//   2. 拦的位置错了：这一层拦在**写着那个值的成员**上，可算不出来的是**下一个**成员的自动取值。
//      而那样的成员常常就是最后一个（语料里 log_RecordCode.jnc:18 的 `Foldable` 正是），
//      根本没有下一个要算。
//
// 所以这一刀把那一句挪到对的地方：算下一格时先取无符号那一面（`v < 0 ? v + 2^w : v`），
// 只有**真有下一个成员要用它、而它又出了这一格的宽度**时才报（`bad/bitflag-neg`）。
//
// 账是这一整轮里最大的一格：逐份榜 lowered 92 -> 120、clean 166 -> 200、pairs 7243 -> 7075。
// 一条记错了 94 刀的账，拦住了 168 对、28 份文件。
//
// 尺子 `/tmp/c140.c`：C 里这几个值就是普通的常量，手写的是"那张表该长什么样"。
// 同一串数（1 2 4 / -9223372036854775808 / 1 2）。

bitflag enum Wide: uint64_t {
	A,                                   // 1
	B,                                   // 2
	C,                                   // 4
	Top = 0x8000000000000000,            // 64 位那一格的最高位 —— 它是最后一个，不用算下一个
}

// 32 位那一格上同一件事
bitflag enum Narrow {
	X = 0x80000000,
}

// 显式写了最高位之后**再写显式值**照旧收（不需要自动取值）
bitflag enum Mixed: uint64_t {
	P = 0x8000000000000000,
	Q = 1,
	R = 2,
}

int main() {
	printf("%d %d %d\n", Wide.A, Wide.B, Wide.C);
	printf("%lld\n", Wide.Top);
	printf("%lld %lld\n", Mixed.Q, Mixed.R);
	return 0;
}
