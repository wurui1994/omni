// printf 的 `%e` / `%E`（第三十刀）—— C 的 `%.6e`，方言为此长出 `(ssci E N)`。
//
// 期望输出的出处照旧是一份 `cc -O0` 的孪生程序 —— jancy 的 printf 就是 C 库的 vsnprintf
// （jnc_std_StdLib.cpp:733 -> axl_sl_StringDetails.h:390），所以孪生不是近似而是同一份实现。
// 逐字节相同，五条腿也各自与它相同。
//
// 这一格独有的两处难处（都是先在 C 那边量出来的）：
//   - **进位能把指数顶上去**：`%.2e` 印 9.999 是 `1.00e+01`（不是 `10.00e+00`）。这一条在
//     方言那一层解决 —— `(ssci …)` 的四份实现里都有"顶到 10^(N+1) 就指数加一"那一步。
//   - `#` 要把小数点插在 `e` **前面**：`%#.0e` 印 1.5 是 `2.e+00`。这与 `%f` 的"补在末尾"
//     不是同一件事，所以在 frontend 那一层单独做。
//
// 另外几条与 `%f` 共用同一段规则，这儿一并钉住：默认精度 6、`.*` 的实参是负数时回到 6、
// `+` / 空格 / `0` / `-` 四个标志、宽度与 `*`。指数**至少两位**、符号一定印（`e+00`），
// 三位数的指数照原样长出来（`e+100` / `e-100`）。
//
// 大写走 `(supper …)`，与 `%X` 同一条分工 —— `l=` 那一行的 `%#.0E` 是这两条叠在一起。

int calls = 0;

int bump() {
    calls++;
    return 4;
}

int main() {
    printf("a=[%e] [%E] [%.2e] [%.0e]\n", 1.5, 1.5, 1.5, 1.5);
    printf("b=[%e] [%.2e] [%.0e]\n", 0.0, 0.0, 0.0);
    printf("c=[%.2e] [%.2e] [%.2e]\n", 9.999, 0.0009999, 999.9);
    printf("d=[%e] [%e] [%E]\n", 1e100, 1e-100, 1e-100);
    printf("e=[%.2e] [%.2e]\n", 0.125, 0.375);
    printf("f=[%.20e]\n", 0.1);
    printf("g=[%15.3e] [%-15.3e] [%015.3e]\n", -1.5, -1.5, -1.5);
    printf("h=[%+.2e] [% .2e] [%#.0e] [%#.2e]\n", 1.5, 1.5, 1.5, 1.5);
    printf("i=[%.3e] [%.3e]\n", -0.0, 1234.5678);
    printf("j=[%.*e] [%.*e] [%.*e]\n", 3, 1.5, 0, 9.5, -1, 1.5);
    printf("k=[%*.2e] [%-*.2e]\n", 12, -1.5, 12, -1.5);
    printf("l=[%#.0E] [%+015.3e]\n", 1.5, -1.5);
    printf("m=[%e] [%.30e]\n", 123456789.0, 1.0 / 3.0);
    printf("n=[%.*e]\n", bump(), 1.5);
    printf("calls=%d\n", calls);
    return 0;
}
