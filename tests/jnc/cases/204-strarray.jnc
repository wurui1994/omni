// 串字面量给数组当初值（第二百六十二 / 二百六十三刀）—— jancy 那儿是 `Cast_Array`：串字面量
// 是一段**带零尾**的字节，逐格抄进去；长度写空的（`char a[] = "abc"`）就从那串字数出来。
//
// 真语料里这一句是 `char a[] = "abc"`（test/jnc/test10.jnc:13、test109 / test110 / test112 /
// test130、test/ioninja/common/hexEncoding.jnc …662 份上量出来 23 处，静态字段与局部量各一半）。
//
// **这一层一格窄整数占一格**（`char[4]` 是 `(blk int 4)`），所以"逐字节"就是"逐格"；
// 零尾不用写 —— 那段内存是 `pnew` 出来的、本来就是零（与花括号写少了那几格同一条）。
// 非 ASCII 的串还不收（一个字符要占好几格，等方言的整数带上宽度那一程）。
//
// **模块级**那一格（`char g[] = "abc"`）还没接：它的类型要在"查名"那一层也定下来
// （与花括号那一格同一处），墙记在账上。

// 类里那格静态字段（第二百六十三刀）：`(global C$m_tag …)` 的长度也从那串字来，
// 初值在模块级那段序幕里按格子写。
class C {
	static char m_tag[] = "abc";
	static char m_pad[6] = "hi";
}

int main() {
	// 长度写空：从那串字数出来（3 个字符 + 一格零尾 = 4 格）
	char a[] = "abc";
	printf("%d %d %d %d\n", a[0], a[1], a[2], a[3]);

	// 长度写定：多出来的那几格保持零
	char b[6] = "hi";
	printf("%d %d %d %d\n", b[0], b[1], b[2], b[5]);

	// 正好放得下（3 个字符 + 零尾）
	char c[4] = "xyz";
	printf("%d %d\n", c[2], c[3]);

	// 抄进去之后照旧是一格普通数组：能写、能读
	a[0] = 65;
	printf("%d %d\n", a[0], a[1]);

	// 静态字段那两格
	printf("%d %d %d %d\n", C.m_tag[0], C.m_tag[2], C.m_tag[3], C.m_pad[1]);

	// **十六进制字面量**（第二百六十四刀，samples/jnc/60_HexLiterals.jnc / test58 / test109）：
	// 写出来的那几个字节，**没有零尾**（空白随便写）。
	char h[] = 0x"03 9d";
	printf("%d %d\n", h[0], h[1]);

	// 拼在一起：串的字节 + 十六进制的字节；**一旦拼上十六进制字面量就没有零尾**
	// （60_HexLiterals:51 那句 `"non-zero-terminated" 0x""` 就是靠这条去掉零尾的）。
	char m[] = "ab" 0x"ff";
	printf("%d %d %d\n", m[0], m[1], m[2]);
	return 0;
}
