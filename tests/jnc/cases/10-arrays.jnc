// 定长数组（ADR-0016 第十刀）。jancy 的数组照抄 C/C++ 的模型：**定长**、长度写在声明符上
// （decl_simple.rst："in C/C++ compiler-generated arrays are fixed-sized … Jancy adopts
// C/C++ model: `int a[10][20]`"）。存储是方言的 `(pnew (ptr T) (int N))`，于是 `a[i]` 的
// 越界检查就是方言本来那一条（type_ptr_data.rst："Range is checked on both array accesses
// and pointer dereferences"，rt/arr-oob.jnc 是它的本体）。
//
// 期望输出的出处：**C**，下面这一份 `cc -O0` 编出来的程序，逐字节相同。
//
//   #include <stdio.h>
//   int sum(int* p, int n) { int s = 0; for (int i = 0; i < n; i++) s += p[i]; return s; }
//   int main() {
//       int a[3] = { 1, 2, 3 };
//       printf("a=%d %d %d\n", a[0], a[1], a[2]);
//       a[1] = 20;               printf("a1=%d\n", a[1]);
//       int b[] = { 7, 8 };      printf("b=%d %d\n", b[0], b[1]);
//       int c[2] = { 0 };        printf("c=%d %d\n", c[0], c[1]);
//       int d[4] = { 5, 6 };     printf("d=%d %d %d %d\n", d[0], d[1], d[2], d[3]);
//       int* p = a;              printf("p=%d %d\n", *p, p[2]);
//       p += 2;                  printf("pd=%ld\n", (long)(p - a));
//       int* q = &a[1]; *q = 99; printf("q=%d\n", a[1]);
//       char cs[3] = { 300, -1, 65 };  printf("cs=%d %d %c\n", cs[0], cs[1], cs[2]);
//       double ds[2] = { 1.5 };  printf("ds=%f %f\n", ds[0], ds[1]);
//       int e[5]; for (int i = 0; i < 5; i++) e[i] = i * i;
//       printf("e=%d\n", sum(e, 5));
//       printf("s=%d\n", sum(a, 3));
//       return 0;
//   }
//
// 两处出处**不是** C 而是 jancy：
//   - `int c[2];` 不写初值印 0 0。C 里那是未定值，jancy 那边是定义好的
//     （type_ptr_data.rst："Jancy compiler zeros every variable before any user code can
//     touch it"），所以 C 那份里写成 `= { 0 }` 才对得上。
//   - `int f[3] = { 1, , 3 }` 的空项。C 不收这个写法，jancy 收 —— 空项算**一项**、跳过不写
//     （84_CurlyInitializers.jnc:45 的 `{ ,, 3, 4,,, 7 }` 是七项，其中四项是空的），
//     所以剩下那一格是 pnew 给的零。
int sum(int* p, int n) {
    int s = 0;
    for (int i = 0; i < n; i++) s += p[i];
    return s;
}

int main() {
    int a[3] = { 1, 2, 3 };
    printf("a=%d %d %d\n", a[0], a[1], a[2]);
    a[1] = 20;
    printf("a1=%d\n", a[1]);

    int b[] = { 7, 8 };
    printf("b=%d %d\n", b[0], b[1]);

    int c[2];
    printf("c=%d %d\n", c[0], c[1]);

    int d[4] = { 5, 6 };
    printf("d=%d %d %d %d\n", d[0], d[1], d[2], d[3]);

    // 退化成指针：jancy 的 `int* p = a;`（type_ptr_data.rst:31）。这一层的数组**本来就是**
    // 那个 fat 指针，所以这一句不发一个字的代码 —— 只是类型换了。
    int* p = a;
    printf("p=%d %d\n", *p, p[2]);
    p += 2;
    printf("pd=%d\n", p - a);

    int* q = &a[1];
    *q = 99;
    printf("q=%d\n", a[1]);

    char cs[3] = { 300, -1, 65 };
    printf("cs=%d %d %c\n", cs[0], cs[1], cs[2]);

    double ds[2] = { 1.5 };
    printf("ds=%f %f\n", ds[0], ds[1]);

    int e[5];
    for (int i = 0; i < 5; i++) e[i] = i * i;
    printf("e=%d\n", sum(e, 5));

    printf("s=%d\n", sum(a, 3));

    int f[3] = { 1, , 3 };
    printf("f=%d %d %d\n", f[0], f[1], f[2]);
    return 0;
}
