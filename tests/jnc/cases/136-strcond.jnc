// 第一百四十六刀：字符串当条件用。
//
// 出处是 jancy 的源码，不是猜的：`Cast_BoolFromString::llvmCast`
// （jnc_ct_OperatorMgr/jnc_ct_CastOp_Bool.cpp:96-111）取的是字符串那格结构体的
// `getFieldArray()[2]`，而那张表是 `m_p` / `!m_ptr_sz` / `m_length`
// （jnc_ct_TypeMgr/jnc_ct_TypeMgr.cpp:2031-2039）—— 第 3 个是**长度**。
//
// 所以 `if (s)` 问的是"长度不为零"：
//   - 空串 `""` 是**假**（这一格与"m_p 是不是空"分得开 —— 先前我以为是后者，回去看了一眼源码
//     才知道错了，那正是"话说得越像结论越要看第一个字从哪儿来"这条口径）；
//   - 方言的 `(slen E)` 也是按字节的长度，两边同一件事。
//
// 逼出它的是 `if (!key)`（ui_Dictionary.jnc:32）—— 逐份那张榜上 97 处、一起编那张榜上 1 处，
// 先前一律硬拒（`string 不能当条件用`），那是一句错话。
//
// 期望输出的出处：/tmp/c142.c（`cc -O0 -std=c99 -Wall`）。

void tell(string_t s) {
	if (s)
		printf("yes %s\n", s);
	else
		printf("no\n");
}

int main() {
	string_t a = "hi";
	string_t b = "";

	tell(a);
	tell(b);

	printf("%d %d\n", a ? 1 : 0, !b);

	if (!b && a)
		printf("both\n");

	return 0;
}
