// 第一百三十二刀：泛型的**实例名**不是一层层的命名空间。
//
// 上一刀把 `operator ++` 那一族的墙拆了之后，`--group std` 那张榜上冒出 26 处
// `未声明的变量 'm_p'`，源头是四条这样的话：
//   `结构体 'stdt.IteratorBase.T*' 里的字段 'm_p' 按值套回了自己`
// —— 第一百二十七刀那道自查闸门**认错了人**。
//
// 真正的因是一条查名的路：实例名是 `模板名$实参键` 拼出来的（`Box$Node`），而实例体是拿
// `this.ns = 实例名` 降的（成员 typedef 要在那一层查得着）。`resolve` 往外退一层时按 `$` 掐，
// 于是 `Box$Node` 退成 `Box`，在实例体里写 `Node` 拼出来的正是 `Box$Node` —— **实例它自己**。
// 而 typeSpec 那儿结构体表排在 typedef 表前面，于是这一撞每次都赢。
//
// 改法一句话：实例名要当**一个整体**。`instNs` 记着"这一格实例的模板是在哪一层声明的"，
// 往外退的时候直接跳过去 —— 实例自己那一层照旧先查（成员 typedef 还在），只是不再退成模板名。
//
// 这一格先前是**静默的错答案**那一类：`P* m_p` 落成的是 `Box$Node*`，不是 `Node*`。
// 撞上赋值时它会报"两边不同型"（看着像用户写错了），撞上按值字段时报"套回了自己"，
// 两句都指着别处 —— 所以四个面一起摆在这一份里。
//
// 尺子 `/tmp/c129.c`：手写的是"替换该替出来的那个类型"—— 每一格 `P` 都写成实参那个类型。
// 同一串数（7 / 7 41 / 9 / 5）。

struct Node {
	int m_x;
}

struct Box<P> {
	// 一、指针那一面：先前落成 `Box$Node*`
	P* m_p;
	// 二、按值那一面：先前撞上"按值套回了自己"那道闸门
	P m_v;

	// 三、成员 typedef 照旧在实例自己那一层查得着（这是 `this.ns = 实例名` 本来要办的事）
	typedef P Entry;

	Entry val() {
		return m_v;
	}
}

// 四、把参数**转手给另一格泛型**当实参：实例名是从替换之后那格说明符上重新读出来的
struct Pair<E> {
	Box<E> m_a;
	int m_n;
}

int main() {
	Node n;
	n.m_x = 7;

	Box<Node> b;
	b.m_p = &n;
	printf("%d\n", b.m_p.m_x);

	b.m_v.m_x = 41;
	printf("%d %d\n", b.m_p.m_x, b.val().m_x);

	Pair<Node> p;
	p.m_a.m_v.m_x = 9;
	printf("%d\n", p.m_a.val().m_x);

	// 实参是内建类型的那一格照旧（`int` 撞不上，先前也是对的）
	Box<int> c;
	c.m_v = 5;
	printf("%d\n", c.val());
	return 0;
}
