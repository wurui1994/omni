// 第一百〇五刀：默认值那条界往外挪半格 —— **在声明那一头折得出编译期整数**的也收。
//
// 榜上 `这个形状的默认值` 84 份 / 87 处，拆开看只有三种源头，而 80 多份是同一行经 `-I`
// 重读出来的：
//   - `void addSpacing(int size = Def_Spacing);`（test/ioninja/api/ui_ToolBar.jnc:45）
//     —— `Def_Spacing` 是 `opaque class ToolBar` 里那格**无名枚举**的成员（第九十六刀漏到
//     类那一层）。调它的插件在别的命名空间里，按调用点查名一辈子查不着；
//   - `char sep = ','`（test/ioninja/common/formatInteger.jnc:12）—— 第九十七刀之后
//     `','` 已经是一格编译期整数了，只是老那条界的白名单里没写它；
//   - `uint64_t timestamp = sys.getTimestamp()`（ui_StdSessionInfoSet.jnc:70）—— 一次
//     宿主调用，折不出常量，仍旧在界外。
//
// 落法：老那条界（defShapeOk）**一个字不动**，过得了的照旧原样搬。过不了的再试一次
// `constInt`，而且是在**声明那一头**的作用域里试（`defNs` = 那个函数全名去掉最后一段,
// resolve 从那儿往外退 —— 与 jancy 的 `ParseContext.cpp:32-38` 同一条规矩）。折得动就把
// 那一格换成**一格字面量**：于是名字压根没进调用点，"名字撞上调用方局部量"这条老隐患
// 从源头没了 —— 搬过去的是一个数。
//
// 期望输出的出处：/tmp/c105.c（`cc -O0 -std=c99 -Wall`）。

namespace ui {

class ToolBar {
	enum {
		Def_Spacing = 6,
	}

	enum {
		Neg_Base = -3,
	}

	int addSpacing(int size = Def_Spacing) {
		return size;
	}

	// 折出来的常量还能参与运算
	int addSpacing2(int size = Def_Spacing * 2 + 1) {
		return size;
	}

	// 折出来是负数：字面量本身只收非负那一串，减号在字面量之外
	int addNeg(int size = Neg_Base) {
		return size;
	}

	int three(
		int a,
		int b = Def_Spacing,
		int c = Def_Spacing
	) {
		return a * 100 + b * 10 + c;
	}
}

} // namespace ui

// 字符字面量的默认值（第九十七刀 + 这一刀）
int sep2(char sep = ',') {
	return (int)sep;
}

int diff(char d = 'a' - 'A') {
	return (int)d;
}

int main() {
	ui.ToolBar* t = new ui.ToolBar;
	printf("%d %d\n", t.addSpacing(), t.addSpacing(9));
	printf("%d\n", t.addSpacing2());
	printf("%d\n", sep2());
	printf("%d\n", diff());
	printf("%d\n", t.addNeg());
	printf("%d\n", t.three(1, , 3));      // 中间那格空槽（第八十八刀）也走同一条路
	printf("%d\n", t.three(1));
	return 0;
}
