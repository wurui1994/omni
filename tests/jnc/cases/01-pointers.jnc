// ADR-0016 第一刀的门槛本体：一个 .jnc 里 struct + int* + 指针算术 + 逐字段读写，
// 在五条腿上给同一个答案。指针在这五条腿上是**两套实现**（JS 与两个解释器是 arena
// 模拟、C 与 LLVM 是真指针），所以"五方逐字节相同"才是这条 case 要证的东西。
//
// 期望输出的出处（这一路没有 oracle，每一条都注明来源）：
//   - `new int[3]` 出来那块是零初始化的：type_ptr_data.rst「Jancy compiler zeros
//     every variable before any user code can touch it」-> 第一行 0
//   - `p[i]` 就是 `*(p + i)`，范围检查在**解引用**而不是算术上：同一份文档里
//     `p += i; *p = 40;` 那段 -> `q = p + 2` 本身不报错
//   - 指针差按**元素**而不是字节：C 的指针差语义，jancy 没改这一条 -> q - p 是 2
//   - 结构体字段偏移按自然对齐：见 stage0/src/hir/types.js 的 structLayout ——
//     a 在 0（int，8）、b 在 8（real，8）、c 在 16（bool，1），总长补到 24。
//     所以 `(h + 1)->a` 是第二个元素的 a，还没写过，是 0。
//   - `printf` 的 `%d` / `%f`：Jancy 的 printf 是 C 的那一套（stdlib 里就是 vararg
//     的 printf）；`%f` 印 1.5 是 real 的十进制写法，与方言的 tostr 一致。

struct Hdr {
    int a;
    double b;
    bool c;
}

int add(int x, int y) {
    return x + y;
}

// 指针穿过普通函数：指针是**值**（三个字抄一份），指向的那块是共享的
void bump(int* p, int d) {
    *p = *p + d;
}

int main() {
    int* p = new int[3];
    printf("%d\n", *p);

    *p = 10;
    p[1] = 20;
    p[2] = 30;
    printf("%d %d %d\n", *p, p[1], p[2]);

    int* q = p + 2;
    printf("%d %d\n", q - p, *q);

    // 走出块外**不报错**（只有解引用才报），走回来照旧能读
    int* far = p + 7;
    printf("%d\n", far[-6]);

    // 别名：指针本身抄一份，指向的那块是同一段
    int* r = p;
    *r = 99;
    printf("%d\n", *p);

    bump(p, 1);
    printf("%d\n", *p);

    int i = 0;
    int sum = 0;
    for (i = 0; i < 3; i++)
        sum += p[i];
    printf("%d %d\n", sum, add(sum, 1));

    Hdr* h = new Hdr[2];
    h->a = 7;
    h->b = 1.5;
    h->c = true;
    printf("%d %f\n", h->a, h->b);
    printf("%d\n", (*h).a);
    // 第二个元素还是零 —— 说明 h + 1 的步长是 sizeof(Hdr) = 24 而不是别的
    printf("%d\n", (h + 1)->a);

    int* z = null;
    if (z == null)
        printf("z is null\n");
    if (p != null)
        printf("p is not null\n");

    return 0;
}
