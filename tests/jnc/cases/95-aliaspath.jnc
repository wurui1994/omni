// 第一百〇四刀：**字段路径**的 alias。第八十七刀把 alias 的类型那一支与函数 / 方法那一支
// 收了，字段路径那一支当时刻意留着（`bad/alias-fieldpath` 就是那条边界）。语料里的出处只有
// 一处、三行：
//   class MapBase<T> {
//       List<T, Iterator, ConstIterator> m_list;
//       alias m_head = m_list.m_head;
//       alias m_tail = m_list.m_tail;
//       alias m_count = m_list.m_count;
//   }
// （src/jnc_ext/jnc_std/jnc/stdt_Map.jnc:85-87）—— 别名指的不是一格类型、也不是一格函数，
// 而是"另一格对象里的一格字段"。
//
// 落法：`名字 -> 一串取字段`。声明那一刻逐段在字段表里解开（`this.structs` 对类与结构体都有
// 那张表），记下路径与末端的类型；查名的两处**各展开一次**：
//   - `obj.别名`  -> memberOf 里"没有这个字段"之前先问一句 aliasPath；
//   - 裸写 `别名` -> selfPathLv，基那一格是 `$this`。
// 展开出来的就是货真价实的一串 `(pfield … )`，所以读、写、`++`、`+=`、后面继续取字段、
// 整格拷贝这几条一处都不用再管 —— 与"源码里真写出那一串"走的是同一条路。
// 类字段那一格里放的也是地址（第十二刀），所以叠 pfield 时不用分辨中间那一格是类还是结构体。
//
// 期望输出的出处：/tmp/c104.c（`cc -O0 -std=c99 -Wall`）。

struct Node {
	int m_val;
}

struct List {
	Node m_head;
	int m_len;
}

class Map {
	List m_list;
	int m_own;

	// 语料里那三行的形状：类里的字段路径别名
	alias m_head = m_list.m_head;
	alias m_len = m_list.m_len;

	construct() {
		m_head.m_val = 1;        // 裸写别名、后面还继续取一格字段（写）
		m_len = 2;               // 裸写别名（写）
		m_own = 3;
	}

	int bump() {
		m_len++;                 // 就地改：++
		m_head.m_val += 10;      // 就地改：复合赋值
		return m_len;            // 裸写别名（读）
	}

	// 别名指着一格结构体时它自己还是一格 agg：整格拷贝要成立
	int headVal() {
		Node n = m_head;
		return n.m_val;
	}
}

struct Inner {
	int m_x;
}

struct Outer {
	Inner m_in;
}

/* 结构体里的字段路径别名（第一百〇二刀收了结构体里的 alias，这一刀把路径那一支接上），
   而且路径是**两层**的 —— 展开是逐段叠，层数没有上限。 */
struct Holder {
	Outer m_out;

	alias m_x = m_out.m_in.m_x;

	int twice() {
		return m_x * 2;
	}
}

int main() {
	Map* m = new Map;
	printf("%d %d %d\n", m.m_len, m.m_head.m_val, m.m_own);

	m.m_len = 5;                 // obj.别名（写）
	printf("%d %d\n", m.m_len, m.m_list.m_len);

	printf("%d\n", m.bump());
	printf("%d %d\n", m.m_head.m_val, m.headVal());

	m.m_head.m_val = 7;          // obj.别名 后面继续取字段（写）
	printf("%d %d\n", m.m_head.m_val, m.m_list.m_head.m_val);

	Holder h;
	h.m_x = 9;
	printf("%d\n", h.m_out.m_in.m_x);
	printf("%d\n", h.twice());
	return 0;
}
