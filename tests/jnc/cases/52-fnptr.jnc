// 函数指针（第五十五刀）。jancy 的写法是 `R function* p(形参)`，那一格里放的是
// "函数 + 一个闭包对象"（type_ptr_function.rst 的 fat function pointer）——
// 落到方言的函数值那一格（`(fnty …)` / `(fnref …)` / `(mkclo …)` / `(callfn …)`）。

int add(int a, int b) {
	return a + b;
}

int mul(int a, int b) {
	return a * b;
}

void shout(int x) {
	printf("shout %d\n", x);
}

// 模块级的那一格：出来是零，赋过值才调得动。
int function* g_op(int, int);

// typedef 起的名字（第三十八刀那一格）也装得下它 —— 那一层本来就是"直接拿解出来的类型当 base"。
typedef int function* BinOp(int, int);

// 函数指针当形参：这一格就是"高阶函数"。
int apply2(int function* op(int, int), int a, int b) {
	return op(a, b);
}

// 回一格函数指针（返回类型走 typedef 那个名字）：调出来那一格可以直接再调。
BinOp pick(int k) {
	if (k == 0)
		return add;
	return mul;
}

class Counter {
	int m_n;

	construct(int n) {
		m_n = n;
	}

	int bump(int d) {
		m_n = m_n + d;
		return m_n;
	}

	int total() {
		return m_n;
	}
}

int main() {
	int function* p(int, int) = add;
	printf("%d\n", p(3, 4));
	// 重新赋一个：函数指针就是一格普通的值
	p = mul;
	printf("%d\n", p(3, 4));

	// 不回值的那一种
	void function* v(int) = shout;
	v(9);

	g_op = add;
	printf("%d\n", g_op(1, 2));
	printf("%d\n", apply2(mul, 5, 6));
	// 把一格函数指针再传下去
	printf("%d\n", apply2(p, 7, 8));

	// `function thin*`：不带闭包的那一种，方言这一格装得下它
	int function thin* t(int, int) = add;
	printf("%d\n", t(10, 20));

	BinOp z = mul;
	printf("%d\n", z(6, 7));

	// 调出来的那一格再调一次
	printf("%d\n", pick(0)(3, 4));
	printf("%d\n", pick(1)(3, 4));

	// `c.bump`：fat 指针捕的就是那个对象，所以它改的是 c 自己那一格
	Counter c(100);
	int function* b(int) = c.bump;
	printf("%d\n", b(5));
	printf("%d\n", b(5));
	printf("%d\n", c.total());
	// 同一个方法在另一个对象上是另一格
	Counter d(7);
	int function* e(int) = d.bump;
	printf("%d\n", e(1));
	printf("%d\n", c.total());
	return 0;
}
