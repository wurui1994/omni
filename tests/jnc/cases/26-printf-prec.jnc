// printf 的最后两条（第二十七刀）：**整数与 `%s` 上的精度**，以及**宽度/精度从实参来**
// （`%*d` / `%.*d` / `%.*s`）。
//
// 为什么这一份的孪生是**一等**的出处：jancy 的 `printf` 不是自己写的格式化器 ——
// `jnc_std_StdLib.cpp:733` 的 `std::printf` 一句 `sl::formatString_va(formatString, va)`，
// 而那一路（axl_sl_StringDetails.h:390/401）就是**C 库的 `vsnprintf`**。所以这几条的语义
// 逐字就是 C 的，`cc -O0` 的孪生程序不是近似而是同一份实现。
//
// 量在里面的：
//   - 整数精度是"**至少**几位数字"，零补在**符号后面**（`%.3d` 印 -7 是 `-007`）
//   - 精度是 0 而值是 0 时**一个字符都不印**（C99 7.19.6.1）
//   - 精度与宽度是两件事（`%8.3d` 先补到三位数字、再补到八个字符宽），而且整数上
//     **一写精度 `0` 标志就作废**（`%08.3d` 补的是空格）
//   - 宽度 1 平时不用补，可精度能把那段变成空串（`%1.0d` 印 0 是一格空格）
//   - `%x` / `%X` / `%o` 上的精度算的是那几位十六/八进制数字
//   - `%s` 上的精度是"**最多**几个字符"
//   - `%*d` 的宽度**是负数时等于写了 `-` 标志**、宽度取绝对值（C99 7.19.6.1）
//   - `%.*d` 的精度是负数时"等于没写精度"
//   - `*` 那一格的实参**只求一次**（`bump()` 只被调一次）
//
// 没接的一条另有出处：`%.*f`。方言的 `(sfix E N)` 现在要求 N 写成字面量
// （sexpr/lower.js 那句"(sfix E N) 的位数要写成字面量 (int N)"），而 `%.*f` 的位数运行期
// 才知道 —— 那要动方言与五条腿，见 `bad/printf-star-prec-f.jnc`。
//
// `%c` 上的精度也拒：C 里它是**未定义行为**（clang 直说 "precision used with 'c'
// conversion specifier, resulting in undefined behavior"），没有可对的答案。

int calls = 0;

int bump() {
    calls++;
    return 3;
}

int main() {
    // 整数上的精度：至少 N 位，零补在符号后面
    printf("a=[%.3d] [%.3d] [%.5d]\n", 7, -7, 42);
    printf("b=[%.0d] [%.0d] [%.1d]\n", 0, 5, 0);
    // 精度与宽度是两件事；写了精度 `0` 标志作废
    printf("c=[%8.3d] [%-8.3d] [%08.3d]\n", 7, 7, 7);
    printf("d=[%1.0d] [%3.0d]\n", 0, 0);
    // %x / %X / %o 上的精度
    printf("e=[%.4x] [%.4X] [%.4o] [%.0x]\n", 255, 255, 8, 0);
    // %s 上的精度：最多 N 个字符
    printf("f=[%.3s] [%.10s] [%.0s]\n", "abcdef", "abc", "abc");
    printf("g=[%8.3s] [%-8.3s]\n", "abcdef", "abcdef");
    // `*`：宽度从实参来（负数等于 `-` 标志）
    printf("h=[%*d] [%*d] [%-*d]\n", 6, 42, -6, 42, 6, 42);
    printf("i=[%0*d] [%*s]\n", 6, -42, 6, "ab");
    // `.*`：精度从实参来（负数等于没写精度）
    printf("j=[%.*d] [%.*d] [%.*s]\n", 4, 42, -1, 42, 2, "abcd");
    printf("k=[%.2f] [%.0f]\n", 1.5, 1.5);
    // 两个都从实参来
    printf("l=[%*.*d] [%*.*s]\n", 8, 4, -42, 8, 3, "abcdef");
    // 写了 `0`、精度又是 `.*` 且实参是负数 —— 那等于精度没写，`0` 又活着
    printf("m=[%0*.*d]\n", 8, -1, -42);
    // `%c` 上的宽度照旧（精度在 C 里是未定义行为，前端拒）
    printf("n=[%3c] [%-3c] [%*c]\n", 66, 67, 4, 68);
    // 动态宽度 + 静态精度
    printf("o=[%*.2f] [%-*.3s]\n", 9, 1.5, 5, "abcdef");
    // 星号那一格是个表达式，不必是字面量
    int w = 7;
    printf("p=[%*d] [%.*d]\n", w, 42, w - 4, 5);
    // 星号那一格只求一次
    printf("q=[%*d]\n", bump(), 1);
    printf("calls=%d\n", calls);
    return 0;
}
