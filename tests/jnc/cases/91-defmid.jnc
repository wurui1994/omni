// 第九十九刀：默认值挂在**哪一格形参上都行**。
//
// 先前这一层照 C++ 那条"只能挂末尾"拦着（语料 100 对），理由写的是"中间那格空着调用点
// 说不清"。那句在 jancy 上不成立，两条：
//   - jancy 检查默认值是**按位置一格一格**问的 —— `OperatorMgr_Call.cpp:421-435` 与
//     :447-460 那两段循环，报的是 "argument (%d) of '%s' has no default value"，
//     没有任何"必须在末尾"的规矩；
//   - "中间那格空着怎么说"第八十八刀已经给出来了：`f(1,,3)`（空槽就是"这一格用默认值"）。
//
// 所以这一刀就是把那条拦子撤掉 —— withDefaults 那一遍本来就是按位置查的（中间那格没有
// 默认值时它停下、由个数那一句报），一个字都不用改。
//
// 期望输出的出处：/tmp/c99.c（`cc -O0 -std=c99 -Wall`）。C 写不出"中间那格有默认值"，
// 所以那份尺子把四种调用**各自展开**成一句完整的调用 —— 要对的正是展开之后那四个数。

int f(int a = 1, int b, int c = 3) {
	return a * 100 + b * 10 + c;
}

// 一格都不带默认值的、与全带的，照旧
int g(int a, int b = 2) {
	return a * 10 + b;
}

int main() {
	printf("%d\n", f(9, 8, 7));    // 都给了
	printf("%d\n", f(, 8, 7));     // 第一格用默认（第八十八刀的空槽）
	printf("%d\n", f(9, 8));       // 末尾那格用默认
	printf("%d\n", f(, 8));        // 头尾两格都用默认

	printf("%d\n", g(5));
	printf("%d\n", g(5, 6));
	return 0;
}
