// 完整声明式的属性（第七十五刀）。出处：
//   - prop_full.rst:15 —— 那对花括号开的是**一层命名空间**，取/存两个函数写在里面；
//   - 语料里最常见的形状就是这一种：`property m_remotePort { uint_t get() { … }
//     void set(uint_t value) { … } }`（test/ioninja/plugins/Udp/UdpDispatch.jnc:21-29，
//     整份语料 86 处）；
//   - 属性的类型是**取值器的返回类型**（jancy 那边完整声明式里说明符位置本来就不写类型）。
// 这一层的落法是一次改写：它与"简单声明式 + 两个体外的函数"（第六十八刀）是同一件事，
// 所以属性那一整套一个字都没动 —— 顶层与类的成员都走同一条路。

property g_p {
	int get() {
		return m_hidden + 1;
	}

	void set(int x) {
		printf("g_p.set (%d)\n", x);
		m_hidden = x * 10;
	}
}

int m_hidden;

class Counter {
	int m_n;

	// 类的成员属性：取/存两个函数是这个类的方法（`$this` 由这一层补），体里裸写字段就是
	// `this.m_n`（第五十二刀）。
	property m_doubled {
		int get() {
			return m_n * 2;
		}

		void set(int x) {
			m_n = x / 2;
		}
	}

	// 只有取值器的那一种：jancy 说"没有存值器的属性就是 const 属性"（prop.rst:17）
	property m_isZero {
		bool get() {
			return m_n == 0;
		}
	}
}

int main() {
	g_p = 4;
	printf("g_p = %d\n", g_p);

	Counter* c = new Counter;
	printf("zero %d\n", c.m_isZero);

	c.m_doubled = 42;
	printf("n = %d, doubled = %d, zero = %d\n", c.m_n, c.m_doubled, c.m_isZero);
	return 0;
}
