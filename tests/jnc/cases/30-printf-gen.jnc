// printf 的 `%g` / `%G`（第三十一刀）—— C 的 `%.6g`，方言为此长出 `(sgen E N)` 与
// `(sgenk E N)`（后者是带 `#` 的那一支：**不去尾随零**）。
//
// 期望输出的出处照旧是一份 `cc -O0` 的孪生程序 —— jancy 的 printf 就是 C 库的 vsnprintf
// （jnc_std_StdLib.cpp:733 -> axl_sl_StringDetails.h:390），所以孪生不是近似而是同一份实现。
// 逐字节相同，五条腿也各自与它相同。
//
// C99 7.19.6.1 把 `%g` 定义在 `%e` 与 `%f` **之上**，所以这一格量的是那几条规则本身：
//   - `P = N == 0 ? 1 : N`（精度 0 等于 1）：`%.0g` 印 1.5 是 `2`；
//   - `X` 是"按 `%.{P-1}e` 印会用的指数"，而且是**舍入之后**那个 —— `%.2g` 印 99.9 是
//     `1e+02`（舍成 `1.0e+02`，X 变成 2、于是走 `%e` 那一支），而 `%.2g` 印 9.99 是 `10`
//     （舍成 `1.0e+01`，X 是 1、还在 `%f` 那一支里）；
//   - `-4 <= X < P` 用 `%f`、否则用 `%e`：`%g` 印 0.0001 是 `0.0001`、印 0.00001 是 `1e-05`，
//     印 123456 是 `123456`、印 1234567 是 `1.23457e+06`；
//   - 没写 `#` 时**去掉小数部分的尾随零**（点后面空了连点一起去）：`%g` 印 100 是 `100`、
//     印 3 是 `3`、印 1e6 是 `1e+06`；
//   - `#` 就是"不去"：`%#g` 印 1.5 是 `1.50000`、印 100 是 `100.000`。它还带着 `%f` / `%e`
//     上那条"小数点一定印"：`%#.0g` 印 1.5 是 `2.`、`%#.1g` 印 100 是 `1.e+02`。
//
// 大写走 `(supper …)`，与 `%X` / `%E` 同一条分工。

int main() {
    printf("a=[%g] [%G] [%.3g] [%.0g]\n", 1.5, 1.5, 1234.0, 1.5);
    printf("b=[%g] [%g] [%g] [%g]\n", 0.0001, 0.00001, 123456.0, 1234567.0);
    printf("c=[%g] [%g] [%g]\n", 100.0, 0.0, 3.0);
    printf("d=[%#g] [%#.3g] [%#.0g] [%#g]\n", 1.5, 1.5, 1.5, 100.0);
    printf("e=[%g] [%G] [%g]\n", 1e100, 1e-100, 5e-324);
    printf("f=[%.1g] [%.1g] [%.1g]\n", 0.00099, 0.25, 0.35);
    printf("g=[%.17g] [%.20g]\n", 0.1, 0.1);
    printf("h=[%12.3g] [%-12.3g] [%012.3g]\n", -1234.0, -1234.0, -1234.0);
    printf("i=[%+.3g] [% .3g] [%+g]\n", 1234.0, 1234.0, -0.0);
    printf("j=[%.*g] [%.*g] [%.*g]\n", 3, 1234.0, 0, 1.5, -1, 1.5);
    printf("k=[%g] [%g] [%g]\n", 1e-5, 1e-4, 0.5);
    printf("l=[%.2g] [%.2g] [%.2g]\n", 9.99, 99.9, 0.0999);
    printf("m=[%#.4g] [%#.1g] [%#G]\n", 1.0, 100.0, 1e-100);
    printf("n=[%.30g] [%.3g]\n", 1.0 / 3.0, 0.0);
    printf("o=[%g] [%.10g]\n", 1000000.0, 1e21);
    return 0;
}
