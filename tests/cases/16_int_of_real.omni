// int(real) 是**截断**（朝零），不是四舍五入；超出 i64 范围是运行时错误，
// 既不是 C 的 UB（arm64 饱和 / x86 给 INT64_MIN），也不是 JS 的静默回绕。
print(int(3.7));
print(int(-3.7));
print(int(0.0));
print(int(-0.5));
print(int(2.5));
print(int(-2.5));

// double 的整数精度边界：2^53+1 存不下，落到 2^53
print(int(9007199254740993.0));

// i64 的两端。9223372036854773760 = 2^63 - 2048，是小于 2^63 的最大 double
// （那一段的 double 间距是 2^11），9223372036854775807 本身不可表示。
print(int(-9223372036854775808.0));
print(int(9223372036854773760.0));

// 越界：到这行终止，下面的 print 不会执行
print(int(1e20));
print(777);
