;; mini —— 这条语法的看点全在**映射**上：$*k 摊平列表。
;; 所以这些 case 挑的都是「摊平对不对」的地方：语句序列、形参表、实参表、
;; 以及 Block 出裸列表、用到语句位置时才包 (do ...)。
;; 树的另一半（这份语法真能跑）在 tests/sexpr/run.js 那条轴上。

;; 最小的一份：main 的 Block 摊进 (main ...)
main { print 1; }                               ==> (module (main (print (int 1))))

;; 形参在语法里是 `int a`，核心方言要 `(a int)` —— Param 的模板 ($2 $1) 换了顺序；
;; 空 Block 摊出来就是 (main)，不是 (main ())
fn f(int a, real b) int { return a; } main { }  ==> (module (fn f ((a int) (b real)) int (ret (var a))) (main))

;; if/else 两支各自 $*5 / $*7，包成 (do ...)
main { if (true) { print 1; } else { print 2; } } ==> (module (main (if (bool true) (do (print (int 1))) (do (print (int 2))))))

;; 实参表：(call $1 $*3) 把 ArgList 摊在函数名后面，而不是嵌一层
main { g(1, 2, 3); }                            ==> (module (main (expr (call g (int 1) (int 2) (int 3)))))

;; 优先级：* 比 + 紧
main { let x int = 1 + 2 * 3; }                 ==> (module (main (let x int (bin "+" (int 1) (bin "*" (int 2) (int 3))))))

;; while + 赋值语句
main { while (a < b) { a = a + 1; } }           ==> (module (main (while (bin "<" (var a) (var b)) (do (set a (bin "+" (var a) (int 1)))))))

;; 该拒的
main { print 1 }                                !!> unexpected "}"
main { print 1 == 2 == 3; }                     !!> unexpected "=="
main { let x = 1; }                              !!> unexpected "="

;; **方言加的那两样，基准这儿必须仍然不认**（grammars/minidia.grammar 继承的就是这一份）。
;; 假接受比报错坏：解析器认得比它该认的多，错就漏到下游去了。
;; 报的错正好说明它们**没被当成方言那两样**：`say` 只是个名字（后面跟个数说不通），
;; `3i` 是数后面跟了个名字。
main { say 1; }                                 !!> unexpected INT
main { print 3i; }                              !!> unexpected ID
