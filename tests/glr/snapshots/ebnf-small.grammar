exit=0
;; 由 ebnf/small.ebnf 自动转成 —— 别手改这一份，改上游那个 .ebnf。
;;
;; `?` `*` `+` 与分组在转换期展开成了辅助规则（`-opt` / `-star` / `-plus` / `g…`）。
;; 没有 `(lex …)`：一份 .ebnf 不带词法实现，所以这份语法能建表、不能直接吃源文本。
(grammar small
  (tokens identifier number string-lit)
  (start unit)
  (rule unit
    (-> (stmt-star) (unit $1)))
  (rule stmt-star
    (-> () (stmt-star))
    (-> (stmt-star stmt) (stmt-star $1 $2)))
  (rule stmt
    (-> ("return" expr-opt ";") (stmt $1 $2 $3))
    (-> ("if" "(" expr ")" stmt stmt-g-opt) (stmt $1 $2 $3 $4 $5 $6))
    (-> ("{" stmt-star "}") (stmt $1 $2 $3))
    (-> (decl-stmt) (stmt $1))
    (-> (";") (stmt $1)))
  (rule expr-opt
    (-> () (expr-opt))
    (-> (expr) (expr-opt $1)))
  (rule stmt-g-opt
    (-> () (stmt-g-opt))
    (-> (stmt-g) (stmt-g-opt $1)))
  (rule stmt-g
    (-> ("else" stmt) (stmt-g $1 $2)))
  (rule decl-stmt
    (-> ("let" identifier expr-g-opt ";") (decl-stmt $1 $2 $3 $4)))
  (rule expr-g-opt
    (-> () (expr-g-opt))
    (-> (expr-g) (expr-g-opt $1)))
  (rule expr-g
    (-> ("=" expr) (expr-g $1 $2)))
  (rule expr
    (-> (term term-g-star) (expr $1 $2)))
  (rule term-g-star
    (-> () (term-g-star))
    (-> (term-g-star term-g) (term-g-star $1 $2)))
  (rule term-g
    (-> (g term) (term-g $1 $2)))
  (rule g
    (-> ("+") (g $1))
    (-> ("-") (g $1)))
  (rule term
    (-> (identifier) (term $1))
    (-> (number) (term $1))
    (-> (string-lit) (term $1))
    (-> ("\"" identifier "\"") (term $1 $2 $3))
    (-> (identifier "[" expr-opt "]") (term $1 $2 $3 $4))
    (-> ("(" expr ")") (term $1 $2 $3)))
  (rule opt-tail
    (-> ("," expr) (opt-tail $1 $2))
    (-> () (opt-tail)))
  (rule name-list
    (-> (identifier-plus) (name-list $1)))
  (rule identifier-plus
    (-> (identifier) (identifier-plus $1))
    (-> (identifier-plus identifier) (identifier-plus $1 $2))))
