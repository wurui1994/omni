;; 缩进即块结构（python / nim / mojo 那一族）的**最小判据**。
;;
;; 这一份不是玩具语言的样板，是词法器那一格 `(indent …)` 的尺子 —— 它要证四件事：
;;   1. 缩进变深发一格 INDENT、变浅发相应数量的 DEDENT；
;;   2. **空行与纯注释行不出记号**（不然每个空行都会多一格 NEWLINE）；
;;   3. **括号里面的换行是续行**，不发 NEWLINE / INDENT / DEDENT（隐式行连接）；
;;   4. 文件尾把栈弹空（最后一个块要收得了尾）。
(grammar indent
  (tokens NAME NUM NL IND DED)
  (start prog)
  (lex
    (skip (+ (set " \t")))
    (comment "#" (* (not "\n")))
    (indent NL IND DED (brackets "()" "[]"))
    (token NUM (+ digit))
    (token NAME (or alpha "_") (* (or alnum "_")))
    (keyword NAME "if" "def")
    (op "(" ")" "[" "]" ":" "," "+" "="))
  (rule prog
    (-> (stmts) (prog $*1)))
  (rule stmts
    (-> () ())
    (-> (stmts stmt) ($*1 $2)))
  (rule stmt
    (-> (simple NL) $1)
    (-> ("def" NAME "(" names ")" ":" block) (def $2 (params $*4) $7))
    (-> ("if" expr ":" block) (if $2 $4)))
  (rule block
    (-> (NL IND stmts DED) (block $*3)))
  (rule simple
    (-> (expr) (expr $1))
    (-> (NAME "=" expr) (set $1 $3)))
  (rule names
    (-> () ())
    (-> (NAME) ($1))
    (-> (names "," NAME) ($*1 $3)))
  (rule expr
    (-> (atom) $1)
    (-> (expr "+" atom) (add $1 $3)))
  (rule atom
    (-> (NUM) (num $1))
    (-> (NAME) (name $1))
    (-> (NAME "(" args ")") (call $1 (args $*3)))
    (-> ("(" expr ")") (paren $2))
    (-> ("[" args "]") (list $*2)))
  (rule args
    (-> () ())
    (-> (expr) ($1))
    (-> (args "," expr) ($*1 $3))))
