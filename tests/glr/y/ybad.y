/* tests/glr/y/ybad.y —— 看不懂就报错，不猜（glr/yacc.js 头部最后一段）
 *
 * 正则的子集是刻意小的。这一份把「折不动」的那一格摆出来：`{n,m}` 我们的匹配器表达不了
 * （它贪心、不回溯、没有计数），于是转换必须**当场**说不支持，而不是折成一个近似的模式 ——
 * 近似的那种错会在某一门语言的某一份源码上突然表现成"少一个 token"，那种错没有根因。
 */

%skip WS   \s+
%lex HEX   0x[0-9a-f]{2,4}

%token HEX
%start top

%%

top : HEX   { hex }
    ;

%%
