;; SLR(1) 不够、但语言其实不歧义的经典形状（Aho 那本书里的例子改一下）。
;;
;;   S -> A a | b A c | d c | b d a
;;   A -> d
;;
;; 读到 `b d` 之后，项集里同时有 `A -> d .`（来自 `b A c`）和 `S -> b d . a`。
;; FOLLOW(A) = {a, c}，于是 lookahead 是 `a` 时既能归约又能移进 —— SLR 判不了。
;; LALR 能判（那条归约的真实 lookahead 只有 `c`），我们不判，留给 GLR：
;; `b d a` 走移进那支，`b d c` 走归约那支，另一支自己死掉。
;;
;; 这份语法的门槛正好跟 expr.grammar 相反：它**必须**留下冲突。零冲突说明快照过时了。
(grammar lookahead
  (tokens)
  (start S)
  (lex
    (skip space)
    (op "a" "b" "c" "d"))
  (rule S
    (-> (A "a") (s1 $1))
    (-> ("b" A "c") (s2 $2))
    (-> ("d" "c") (s3))
    (-> ("b" "d" "a") (s4)))
  (rule A
    (-> ("d") (A))))
