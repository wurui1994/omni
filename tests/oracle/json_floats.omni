// 对照 Python 的 strtod + printf：json 的浮点**解析**精度，以及 repr(real) 的规格（ADR-0005）。
// 参照实现按 ADR 的文字重新表达一遍 repr 规则（15/16/17 位里第一个能往返的），
// 因此这里真正被检验的是：我们手写的 JS $fmt_g、C 的 snprintf 用法、以及 json 的数字扫描。
import "std/json.omni";

list<string> docs = [
  "0.0", "1.0", "-1.0", "-0.0",
  "0.1", "0.5", "1.5", "-0.25", "0.3",
  "3.14159265358979", "2.718281828459045",
  "1e3", "1e-3", "2.5e10", "1e15", "1e16", "1e20", "1e21", "1e-20",
  "123456789.123456789", "1.0000000000000002",
  "1e-7", "6.02214076e23", "1.602176634e-19",
  "9007199254740993.0", "0.000123456789",
  "1.7976931348623157e308", "2.2250738585072014e-308", "5e-324",
  "1E+2", "1.5E-2", "-1.5e+3",
  "1000000000000000000000.0"
];

// stringifyJson 里的 real 走 repr()
for (string s in docs) { print(stringifyJson(parseJson(s))); }

// print(real) 走 %.6g，两条规则各测一遍
for (string s in docs) { print(parseJson(s).asReal()); }

// 解析出的值参与运算后仍然一致 = 解析结果逐位相同，而不只是打印起来像
for (string s in docs) {
  real v = parseJson(s).asReal();
  print(v * 2.0);
  print(v + 1.0);
}

// repr 的往返性质：文本再解析回来必须是同一个 double
for (string s in docs) {
  real v = parseJson(s).asReal();
  real back = parseJson(stringifyJson(dyn(v))).asReal();
  print(v == back);
}
