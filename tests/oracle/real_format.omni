// 对照 Python 的 '%.6g'（就是 C 的 printf）：print(real) 的格式规格（ADR-0005）
// 这条最容易"两个后端一起错"——JS 侧的 $fmt_g 是手写复刻的，没有外部参照就没人管它。
list<real> vs = [
  0.0, 1.0, -1.0, 0.5, -0.125, 2.5,
  1.0 / 3.0, 2.0 / 3.0, 1.0 / 7.0,
  99999.0, 100000.0, 999999.0, 1000000.0, 1000001.0,
  0.0001, 0.00001, 1.5e-5, 1.0e-20,
  123456789.0, 1.0e20, 1.0e21,
  3.14159265358979, 2.718281828459045,
  1e-4, 9.9999995e5, 0.000123456789
];
for (real v in vs) { print(v); }

// 参与运算之后再打印，确认格式化不依赖字面量文本
real acc = 0.0;
for (real v in vs) {
  acc = acc + v;
  print(acc);
}
print(acc * 1.0e-10);
print(acc / 3.0);
