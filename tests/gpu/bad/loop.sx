;; kernel 里的循环：这一阶段刻意不发。
;;
;; 能做，但 SPIR-V 的循环要 OpLoopMerge 同时给 merge 块与 continue 目标，
;; 而这两个位置的合法性要单独验一遍（`spirv-val` 对结构化控制流的检查最严的就是这里）。
;; 放到第二阶段，和「有设备时真跑一遍」一起做。
(module
  (kernel countup ((v (buf int)))
    (let i int (int 0))
    (while (bin "<" (var i) (blen (var v))) (do
      (bset (var v) (var i) (bin "+" (bget (var v) (var i)) (int 1)))
      (set i (bin "+" (var i) (int 1))))))

  (main
    (let v (buf int) (bnew (buf int) (int 2)))
    (dispatch countup (int 2) (var v))
    (print (blen (var v)))))
