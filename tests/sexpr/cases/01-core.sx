;; 直接写核心方言：这是汇聚点本身的用例（没有 grammar 参与）。
;; 覆盖 fn/main、let/set、if/else、while、brk/cont、ret、print、call、bin/un 的每一种。
(module
  (fn sum_to ((n int)) int
    (let acc int (int 0))
    (let i int (int 1))
    (while (bin "<=" (var i) (var n))
      (do
        (set acc (bin "+" (var acc) (var i)))
        (set i (bin "+" (var i) (int 1)))))
    (ret (var acc)))

  (fn classify ((x int)) string
    (if (bin "<" (var x) (int 0))
      (do (ret (str "neg")))
      (do
        (if (bin "==" (var x) (int 0))
          (do (ret (str "zero"))))))
    (ret (str "pos")))

  (fn scale ((x real) (k real)) real
    (ret (bin "*" (var x) (var k))))

  ;; (brk) / (cont)：3 的倍数跳过，攒过 20 就停。两条写在同一个循环里 ——
  ;; "跳出去"和"跳到下一轮"是同一处控制流，分开写反而看不出它们的关系。
  (fn oddsum ((n int)) int
    (let acc int (int 0))
    (let i int (int 0))
    (while (bin "<" (var i) (var n))
      (do
        (set i (bin "+" (var i) (int 1)))
        (if (bin "==" (bin "%" (var i) (int 3)) (int 0)) (do (cont)))
        (if (bin ">" (var acc) (int 20)) (do (brk)))
        (set acc (bin "+" (var acc) (var i)))))
    (ret (var acc)))

  (main
    (print (call sum_to (int 100)))
    (print (call classify (un "-" (int 3))))
    (print (call classify (int 0)))
    (print (call classify (int 7)))
    (print (call scale (real 1.5) (real 4.0)))
    (print (bin "&&" (bin ">" (call sum_to (int 3)) (int 5)) (un "!" (bool false))))
    (print (bin "+" (str "core") (str " dialect")))
    (print (call oddsum (int 100)))
    ;; int <-> real 的显式转换。两个方向都要有用例：截断是**朝零**的（-3.7 -> -3），
    ;; 这一条在五条腿上都得一样，而它正是那种"错了也不报错"的地方。
    (print (bin "/" (toreal (int 1)) (toreal (int 3))))
    (print (toint (real 3.7)))
    (print (toint (real -3.7)))
    ;; (rmath "NAME" A [B])：real 上的数学函数。白名单只有七个，判据是**量过五条腿逐字节
    ;; 相同**：sqrt 是 IEEE 规定唯一正确的，fabs/floor/ceil/round/fmod 是精确运算，pow 量了
    ;; 80 组随机输入 0 差异。超越函数（exp/log/trig）没收 —— libm 与 V8 在 atan/tan/log/cos
    ;; 的最后一位就分叉，收进来等于给这条轴埋一个"哪天才红"的雷。
    (print (rmath "sqrt" (real 2.0)))
    (print (rmath "fabs" (un "-" (real 2.5))))
    (print (rmath "pow" (real 2.0) (real 10.0)))
    ;; 舍入的三个：负数各来一条。round 是**离零**舍入（-2.5 -> -3），而 JS 的 Math.round
    ;; 会给 -2 —— 两条 JS 腿要自己绕过去，所以这一条必须在。
    (print (rmath "floor" (un "-" (real 2.5))))
    (print (rmath "ceil" (un "-" (real 2.5))))
    (print (rmath "round" (un "-" (real 2.5))))
    (print (rmath "round" (real 2.5)))
    ;; fmod 的符号跟**被除数**一致（不是数学上的模）
    (print (rmath "fmod" (un "-" (real 7.5)) (real 2.0)))
    (print (rmath "fmod" (real 7.5) (un "-" (real 2.0))))
    ;; 结果照常参与运算，不是只能直接 print
    (print (bin "<" (rmath "sqrt" (real 2.0)) (real 1.4142136)))
    ;; nextafter —— 那个交集的**例外**（ADR-0019 路 2）：`Math.*` 里没有它，JS 那侧是
    ;; 手写的（位模式当 i64 加减一）。它凭什么还能进这个"五条腿逐字节"的名单：它是
    ;; **精确运算**（IEEE-754 5.3.1 的 nextUp/nextDown），不像超越函数那样有"哪家 libm
    ;; 的最后一位"的问题。
    ;;
    ;; 用例的形状要小心：`print` 只印 6 位有效数字，直接印 `nextafter(1, 2)` 与印 `1`
    ;; 一模一样 —— 那样这条用例**根本压不住**手写那一份是不是真的挪了一格。所以印**差值**
    ;; 与比较的结果，让那一个 ulp 露出来。
    (print (bin "-" (rmath "nextafter" (real 1.0) (real 2.0)) (real 1.0)))
    (print (bin "-" (rmath "nextafter" (real 1.0) (real 0.0)) (real 1.0)))
    ;; x == y 时回 y（C99），不是"往某个方向挪一格"
    (print (bin "==" (rmath "nextafter" (real 2.5) (real 2.5)) (real 2.5)))
    ;; 负数那一侧：往 0 走是**变大**（位模式反而减一）
    (print (bin ">" (rmath "nextafter" (un "-" (real 1.0)) (real 0.0)) (un "-" (real 1.0))))
    ;; 0 要单列：±0 往两侧都跳到最小非正规数，符号跟着 y
    (print (bin ">" (rmath "nextafter" (real 0.0) (real 1.0)) (real 0.0)))
    (print (bin "<" (rmath "nextafter" (real 0.0) (un "-" (real 1.0))) (real 0.0)))))
