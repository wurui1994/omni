;; 字符串：拼接、比较、UTF-8。这一份的存在理由是 LLVM 后端第二阶段 ——
;; `omni_str` 是 16 字节聚合，clang 把它降成 `[2 x i64]` 按值传，而 `omni_str_cmp`
;; 是 static inline（call 不到，只能在 IR 里用 memcmp 重建）。两处都错得很安静，
;; 所以要有一份用例把「前缀相同时短者在前」「非 ASCII 按字节序」这些边角钉住。
(module
  (fn cmp2 ((a string) (b string)) string
    (if (bin "<" (var a) (var b)) (do (ret (str "lt"))))
    (if (bin ">" (var a) (var b)) (do (ret (str "gt"))))
    (ret (str "eq")))

  (fn twice ((s string)) string
    (ret (bin "+" (var s) (var s))))

  (main
    ;; 拼接：空串、多次、嵌套
    (print (bin "+" (str "") (str "a")))
    (print (bin "+" (bin "+" (str "x") (str "y")) (str "z")))
    (print (call twice (str "ab")))

    ;; 相等与不等
    (print (bin "==" (str "abc") (str "abc")))
    (print (bin "==" (str "abc") (str "abd")))
    (print (bin "!=" (str "abc") (str "ab")))
    (print (bin "==" (str "") (str "")))

    ;; 前缀相同时短者在前 —— memcmp 只比 min(len) 字节，剩下的靠长度定序
    (print (call cmp2 (str "ab") (str "abc")))
    (print (call cmp2 (str "abc") (str "ab")))
    (print (call cmp2 (str "abc") (str "abc")))
    (print (bin "<=" (str "ab") (str "ab")))
    (print (bin ">=" (str "b") (str "a")))

    ;; 非 ASCII：Omni string 是 UTF-8 字节序列（ADR-0005），比较就是字节序
    (print (bin "+" (str "中") (str "文")))
    (print (bin "<" (str "a") (str "中")))
    (print (call twice (str "😀")))

    ;; (tostr E)：数值/布尔拼进句子里。三种参数类型各一条 —— LLVM 那条腿是按
    ;; `to_string.类型` 单态查符号表的，漏一个就只有那一种类型会炸。
    ;; 格式跟 print 的同一份（real 是 %.6g），所以这里的期望值也钉住了"不另造一份格式"。
    (print (bin "+" (str "n = ") (tostr (int -42))))
    (print (bin "+" (str "r = ") (tostr (bin "/" (real 1.0) (real 3.0)))))
    (print (bin "+" (bin "+" (tostr (bool true)) (str "/")) (tostr (bool false))))
    (print (bin "+" (bin "+" (tostr (int 1)) (str "\t")) (tostr (int 2))))

    ;; (tostr E N)：按 N 位有效数字。加它的理由是别的语言有别的默认位数（asy 是 %.15g），
    ;; 而"看值用的" %.6g 逐字节对不上。五条腿必须给出同一串字符 —— C 走 %.*g、两条 JS
    ;; 走同一份 $fmt_g、LLVM 走 omni_str_realg，四份实现只有这一条用例盯着。
    (print (tostr (bin "/" (real 1.0) (real 3.0)) (int 15)))
    (print (tostr (bin "+" (real 0.1) (real 0.2)) (int 15)))
    (print (tostr (real 1e20) (int 15)))
    (print (tostr (real 1e-5) (int 15)))
    (print (tostr (un "-" (real 0.0)) (int 15)))
    (print (tostr (real 123456789012345678.0) (int 15)))
    ;; 两头：1 位和 17 位（%.0g 没有定义，18 位对 double 没有意义 —— 方言把 N 限在 1..17）
    (print (tostr (real 1234.5678) (int 1)))
    (print (tostr (real 1234.5678) (int 17)))

    ;; (slen E) / (ssub E I N) / (sfind E T)：长度、子串、找子串，全**按字节**。
    ;; OIR 侧这三个 Builtin 早就在（Omni 自己的 s.length / s.substr / s.indexOf），
    ;; 所以四条腿一行没改；LLVM 那条腿是三条新 ABI（omni_str_length / omni_str_sub /
    ;; omni_index_of），漏一个就只有那一条炸，所以每条都要有用例。
    (let s string (str "hello world"))
    (print (tostr (slen (var s))))
    (print (ssub (var s) (int 0) (int 5)))
    (print (ssub (var s) (int 6) (int 5)))
    (print (ssub (var s) (int 11) (int 0)))
    (print (tostr (sfind (var s) (str "o"))))
    (print (tostr (sfind (var s) (str "world"))))
    (print (tostr (sfind (var s) (str "zz"))))
    ;; 空串在 0 命中（和 JS 的 indexOf 一致），空串的长度是 0
    (print (tostr (sfind (var s) (str ""))))
    (print (tostr (slen (str ""))))
    ;; 非 ASCII：长度是**字节数**不是字符数，子串切在字节上
    (print (tostr (slen (str "中文"))))
    (print (ssub (str "中文") (int 0) (int 3)))
    (print (tostr (sfind (str "中文") (str "文"))))
    ;; 拼起来用：取首尾两个字节
    (print (bin "+" (ssub (var s) (int 0) (int 1)) (ssub (var s) (int 10) (int 1))))))
